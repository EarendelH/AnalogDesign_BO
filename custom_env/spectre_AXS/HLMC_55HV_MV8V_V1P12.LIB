***************************************************************************
*                      MOM CAPACITANCE MODEL CARD                         *
***************************************************************************
*//	1=PORT1; 2=PORT2 
*//	MR:UNIT NUMBER IN NX MULTIPLE NY
*//	NF:FINGER NUMBER
*//	LR:OVERLAP REGION LENGTH
*
.LIB STAT_MOM
.PARAM
+SIGMA_MIS_MOM   = AGAUSS(0,1,1) 
+SIGMA_MC_MOMA   = AGAUSS(0,1,3) 
+SIGMA_MC_MOM    = SIGMA_MC_MOMA 
.ENDL STAT_MOM

.LIB MOM_TT
.PARAM
+DMOM_C0 = 0
.LIB 'HLMC_55HV_MV8V_V1P12.LIB' MOM
.LIB 'HLMC_55HV_MV8V_V1P12.LIB' STAT_MOM
.ENDL MOM_TT

.LIB MOM_FF
.PARAM
+DMOM_C0 = -0.05
.LIB 'HLMC_55HV_MV8V_V1P12.LIB' MOM
.LIB 'HLMC_55HV_MV8V_V1P12.LIB' STAT_MOM
.ENDL MOM_FF

.LIB MOM_SS

.PARAM
+DMOM_C0 = 0.05
.LIB 'HLMC_55HV_MV8V_V1P12.LIB' MOM
