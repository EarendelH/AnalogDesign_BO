.LIB RESISTOR


************************************************************************************  
*                 SILICIDE N+ POLY RESISTOR SUBCIRCUIT NETLIST                     *  
************************************************************************************ 
.SUBCKT RES_NPO N2 N1 SUB L=LR W=WR FLAG_CAP=1 RES_MISMATCH = 1
.PARAM  

.PARAM
*****MISMATCH PARAMETERS*****
+SCALE=1    WEFF = 'W*SCALE-2*DW'    LEFF = 'L*SCALE-2*DL'

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =0.704E-7
************
+RSH = '(11.1559826+DRSH_NPO)+RSHMIS'               DW = '6.577E-09+DDW_NPO'       DL = -4.104E-07                      
+RVC0 = 8.300E-11                RVC1 = 2.819E-5            RVC2 = 4.833E-13                       
+TC1R = 1.817E-03                TC2R = -2.115E-07   

+RO = 'RSH*(L*SCALE-2*DL)/(W*SCALE-2*DW)'  RVC = 'MAX(0,(RVC0 + RVC1 * W *SCALE+ RVC2 * (L/W))/(L*SCALE-2*DL)/(L*SCALE-2*DL))'
+TCOEF(TEMPER) = '1.0+(TEMPER-25.0)*(TC1R+TC2R*(TEMPER-25.0))'  

+COX      = '1.264E-4+DCOX_PPO'              CAPSW   = '(7.745E-11+DCAPSW_PPO)*FLAG_CAP'

C1 N2 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L' 
R1 N2 N1 'TCOEF(TEMPER)*RO*(1.5-1/(2+RVC*V(N2,N1)*V(N2,N1)))' 
C2 N1 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L'

.ENDS RES_NPO 

************************************************************************************  
*                 SILICIDE P+ POLY RESISTOR SUBCIRCUIT NETLIST                     *  
************************************************************************************ 
.SUBCKT RES_PPO N2 N1 SUB L=LR W=WR FLAG_CAP=1 RES_MISMATCH = 1
.PARAM  

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =1.685E-7

+RSH      = '( 12.1+DRSH_PPO)+RSHMIS'      RTC1   =8.093E-4       RTC2 = 3.0349E-6 
+DW       = '(-4.1E-08+DDW_PPO)'     DL   = -8E-7
+JC1A =1E-4 JC1B = -5E-7
+JC2A = 6E-7 JC2B = 7E-12
+RVC1     = 'JC1A+JC1B/L'          RVC2   = '(JC2A+JC2B/L)/L'          
+WEFF     = 'W-2*DW'           LEFF   = 'L-2*DL'
+TCOEF     = '1.0+(TEMPER-25.0)*(RTC1+RTC2*(TEMPER-25.0))' 
+COX      = '1.264E-4+DCOX_PPO'              CAPSW   = '(7.745E-11+DCAPSW_PPO)*FLAG_CAP'



C1 N2 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L' 
R1 N2 N1 'RSH*LEFF/WEFF*TCOEF*MIN(1.0+RVC1*ABS(V(N2,N1))+RVC2*V(N2,N1)*V(N2,N1), 1.6)'  
C2 N1 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L'
.ENDS RES_PPO 

************************************************************************************  
*           NON-SILICIDE N+ DIFFUSION RESISTOR SUBCIRCUIT NETLIST                  *  
************************************************************************************ 
.SUBCKT RES_NDIFSAB N2 N1 SUB L=LR W=WR RES_MISMATCH = 1
.PARAM 

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =4.85E-7
 
+RSH      = '( 125.5+DRSH_NDIFSAB)+RSHMIS'  RTC1   = 1.5E-3      RTC2 = 8.1E-07   
+DW       = '( -5.2E-09+DDW_NDIFSAB) + 5.4E-9'   DL   = -1.26038E-7
+JC1A = 1.01E-3 JC1B = 7.51E-11
+JC2A = 2.00925E-8 JC2B = 3.27E-14
+RVC1     = 'JC1A+JC1B/L'           RVC2   = '(JC2A+JC2B/L)/L' 
+WEFF     = 'W-2*DW'                LEFF   = 'L-2*DL'
+TCOEF     = '1.0+(TEMPER-25.0)*(RTC1+RTC2*(TEMPER-25.0))' 

D1    SUB  N2 NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'  
R1    N2   NB 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D2    SUB  NB NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R2    NB   NC 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D3    SUB  NC NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R3    NC   ND 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D4    SUB  ND NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R4    ND   N1 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D5    SUB  N1 NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'  
.ENDS RES_NDIFSAB   

************************************************************************************  
*               NON-SILICIDE P+ DIFFUSION RESISTOR SUBCIRCUIT NETLIST              *  
************************************************************************************ 
.SUBCKT RES_PDIFSAB N2 N1 SUB L=LR W=WR RES_MISMATCH = 1
.PARAM  

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =2.05E-6

+RSH      = '( 257+DRSH_PDIFSAB)+RSHMIS'   RTC1   = 1.5E-03       RTC2 = 1.4E-06   
+DW       = '( -2.2E-8+DDW_PDIFSAB) + 1.89E-8'    DL   = -1.0725E-7
+JC1A = -2.73E-04 JC1B = 1.56E-10
+JC2A = 8.8E-9 JC2B = 2.28E-14
+RVC1     = 'JC1A+JC1B/L'            RVC2   = '(JC2A+JC2B/L)/L' 
+WEFF     = 'W-2*DW'                 LEFF   = 'L-2*DL'
+TCOEF     = '1.0+(TEMPER-25.0)*(RTC1+RTC2*(TEMPER-25.0))' 

D1    N2   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'
R1    N2   NA 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D2    NA   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R2    NA   NB 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D3    NB   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R3    NB   NC 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D4    NC   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R4    NC   N1 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D5    N1   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'
.ENDS RES_PDIFSAB 

************************************************************************************  
*        NON-SILICIDE N+ POLY RESISTOR SUBCIRCUIT NETLIST (THREE TERMINAL)         *  
************************************************************************************ 
.SUBCKT RES_NPOSAB N2 N1 SUB L=LR W=WR FLAG_CAP=1  RES_MISMATCH = 1 
.PARAM

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =5.595E-6

+RSH = '( 170+DRSH_NPOSAB)+RSHMIS'
+TC1R =-5.5E-5 
+TC2R = 2E-7
+DW ='( 3.8E-008+DDW_NPOSAB)'
+DL =2.2E-8
+JC1A = 5E-5
+JC1B = -2E-9
+JC2A = -3E-9
+JC2B = 1E-15
+WEFF = 'W-2*DW'     
+LEFF = 'L-2*DL'           
+RVC1 = 'JC1A + JC1B / LEFF'       
+RVC2 = '(JC2A + JC2B / LEFF) / LEFF'  
+TCOEF = '1.0+(TEMPER-25.0)*(TC1R+TC2R*(TEMPER-25.0))' 
+COX  = '1.265E-4+DCOX_NPOSAB'  
+CAPSW   = '(7.745E-11+DCAPSW_NPOSAB)*FLAG_CAP'
C1    N2 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF' 
R1    N2 N1 'RSH*LEFF/WEFF*TCOEF*MAX(1.0+RVC1*ABS(V(N2,N1))+RVC2*V(N2,N1)*V(N2,N1),0.85)'
C2    N1 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF'
.ENDS RES_NPOSAB  

************************************************************************************  
*        NON-SILICIDE P+ POLY RESISTOR SUBCIRCUIT NETLIST (THREE TERMINAL)         *  
************************************************************************************ 
.SUBCKT RES_PPOSAB N2 N1 SUB L=LR W=WR FLAG_CAP=1 RES_MISMATCH = 1 
.PARAM

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =8.595E-6

+ RSH = '( 773+DRSH_PPOSAB)+RSHMIS'
+ TC1R = -4.1E-4
+ TC2R = 2.5E-7
+ DW = '( 1.7E-8+DDW_PPOSAB)'
+ DL =1.5E-8
+ JC1A = 6E-4
+ JC1B = -1E-9
+ JC2A = -1E-8
+ JC2B = 1E-15
+ WEFF = 'W-2*DW'     
+ LEFF = 'L-2*DL'           
+ RVC1 = 'JC1A + JC1B / LEFF'       
+ RVC2 = '(JC2A + JC2B / LEFF) / LEFF'  
