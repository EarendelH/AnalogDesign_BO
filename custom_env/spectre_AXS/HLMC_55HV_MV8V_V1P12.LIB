*********************************************************************
*                 1.2V NPN BJT (EMMITTER AREA=225*0.81UM^2)         *
*********************************************************************
.SUBCKT NPN12A182_CKT C B E BJT_MISMATCH = 1 MULTI = 1      
.PARAM     

+DIS_NPN12A182MIS   = '3.7E-020*BJT_MISMATCH*MIS_BJT_SIGMA_2'
+DBF_NPN12A182MIS   = '3.62E-3*BJT_MISMATCH*MIS_BJT_SIGMA_1'

Q1 C B E NPN12A182 AREA=1
.MODEL NPN12A182 NPN
***** FLAG PARAMETER ***
+LEVEL = 1                     TLEV = 1                      TLEVC = 1                     
+SUBS = 1                      
***** DC MODEL PARAMETER ***
