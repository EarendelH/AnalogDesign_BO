.LIB MV60
.SUBCKT N8UD6IO D G S B W=1E-6 L=1E-6 SA=0 SB=0 SD=0 AS=0 AD=0 PS=0 PD=0 NRD=0 NRS=0 SCA=0 SCB=0 SCC=0 NF=1 MULTI=1 MISMATCH=0 GLOBAL_FLAG=0
.PARAM

+GLOBAL_FLAG_MV60  = GLOBAL_FLAG
+MISMATCH_MV60     = MISMATCH
+LEF = 'L + (3E-009) - 2 * (0)'
+WEF = 'W + (2E-009) - 2 * (0)'
+GEO_FAC = '1 / SQRT(WEF * LEF * MULTI)'
+LCAL_VTH0_D_N = '(9.6E-009 * GL_1) * GEO_FAC * MISMATCH_MV60'
+LCAL_U0_D_N = '(5E-010 * GL_2) * GEO_FAC * MISMATCH_MV60'
+GL_RATIO_N8UD6IO = 0.75

+DTOXE_N8UD6IO                =    'TL_DTOXE_N8UD6IO                 + GL_DTOXE_N8UD6IO * GL_RATIO_N8UD6IO                 + MC_DTOXE_N8UD6IO * GL_RATIO_N8UD6IO * G1                '
+DXL_N8UD6IO                  =    'TL_DXL_N8UD6IO                   + GL_DXL_N8UD6IO * GL_RATIO_N8UD6IO                   + MC_DXL_N8UD6IO * GL_RATIO_N8UD6IO * G1                  '
+DXW_N8UD6IO                  =    'TL_DXW_N8UD6IO                   + GL_DXW_N8UD6IO * GL_RATIO_N8UD6IO                   + MC_DXW_N8UD6IO * GL_RATIO_N8UD6IO * G1                  '
+DCF_N8UD6IO                  =    'TL_DCF_N8UD6IO                   + GL_DCF_N8UD6IO * GL_RATIO_N8UD6IO                   + MC_DCF_N8UD6IO * GL_RATIO_N8UD6IO * G1                  '
+DVTH0_N8UD6IO                =    'TL_DVTH0_N8UD6IO                 + GL_DVTH0_N8UD6IO * GL_RATIO_N8UD6IO                 + MC_DVTH0_N8UD6IO * GL_RATIO_N8UD6IO * G1                 + LCAL_VTH0_D_N'
+DLVTH0_N8UD6IO               =    'TL_DLVTH0_N8UD6IO                + GL_DLVTH0_N8UD6IO * GL_RATIO_N8UD6IO                + MC_DLVTH0_N8UD6IO * GL_RATIO_N8UD6IO * G1               '
+DWVTH0_N8UD6IO               =    'TL_DWVTH0_N8UD6IO                + GL_DWVTH0_N8UD6IO * GL_RATIO_N8UD6IO                + MC_DWVTH0_N8UD6IO * GL_RATIO_N8UD6IO * G1               '
+DPVTH0_N8UD6IO               =    'TL_DPVTH0_N8UD6IO                + GL_DPVTH0_N8UD6IO * GL_RATIO_N8UD6IO                + MC_DPVTH0_N8UD6IO * GL_RATIO_N8UD6IO * G1               '
+DU0_N8UD6IO                  =    'TL_DU0_N8UD6IO                   + GL_DU0_N8UD6IO * GL_RATIO_N8UD6IO                   + MC_DU0_N8UD6IO * GL_RATIO_N8UD6IO * G1                   + LCAL_U0_D_N'
+DLU0_N8UD6IO                 =    'TL_DLU0_N8UD6IO                  + GL_DLU0_N8UD6IO * GL_RATIO_N8UD6IO                  + MC_DLU0_N8UD6IO * GL_RATIO_N8UD6IO * G1                 '
+DWU0_N8UD6IO                 =    'TL_DWU0_N8UD6IO                  + GL_DWU0_N8UD6IO * GL_RATIO_N8UD6IO                  + MC_DWU0_N8UD6IO * GL_RATIO_N8UD6IO * G1                 '
+DPU0_N8UD6IO                 =    'TL_DPU0_N8UD6IO                  + GL_DPU0_N8UD6IO * GL_RATIO_N8UD6IO                  + MC_DPU0_N8UD6IO * GL_RATIO_N8UD6IO * G1                 '
