+FC = 0                        FCS = 0                       CJSW = '6E-11*(1+DCJSW_SBD60)'                   
+MJSW = 0.23015                PHP = 0.3                     
***** TEMPERATURE COEFFICIENT ***
+TLEV = 1                      TLEVC = 1                     TREF = 25                     
