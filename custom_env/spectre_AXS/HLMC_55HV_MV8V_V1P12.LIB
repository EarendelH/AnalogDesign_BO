********************************************************
*                                                      *
*                  MOS VARACTOR MODEL                  *
*                                                      *
********************************************************
*
*   MOSFET VARACTOR  :
*        *-------------------------------------------
*        |   MOS VARACTOR SUBCKT   |      1.2V      |
*        |=========================|================|
*        |     N+POLY/NWELL        |   NVAR12_CKT   |
*        *-------------------------------------------
*        |     P+POLY/PWELL        |   PVAR12_CKT   |
*        *-------------------------------------------
*        |     N+POLY/NWELL        |   NVAR8_CKT    |
*        *-------------------------------------------
*
.LIB STAT_VAR
.param
+SIGMA_MIS_VAR    = AGAUSS(0,1,1)
+SIGMA_MC_VAR1    = AGAUSS(0,1,3)
+SIGMA_MC_VAR     = SIGMA_MC_VAR1
.ENDL STAT_VAR
.LIB VAR_TT
.OPTION SCALE=1
.PARAM

+DCGG_PVAR12 = 0          DTOX_PVAR12 = 0
+DCGG_NVAR12 = 0          DTOX_NVAR12 = 0
+AC0_PVAR12  = 4.44E-15   AC0_NVAR12 = 4.44E-15
+BC0_PVAR12  = 1.33E-8    BC0_NVAR12 = 1.33E-8
+CC0_PVAR12  = 1.33E-4    CC0_NVAR12 = 1.33E-4
+DCGG_VAR8   = 0

.LIB 'HLMC_55HV_MV8V_V1P12.LIB' VAR_CKT
.ENDL  VAR_TT
***********************************
.LIB VAR_FF
.OPTION SCALE=1
.PARAM

+DCGG_PVAR12  = 0.05       DTOX_PVAR12 = -4.72E-11
+DCGG_NVAR12  = 0.05       DTOX_NVAR12 = -4.72E-11
+AC0_PVAR12   = 4.44E-15   AC0_NVAR12 = 4.44E-15
+BC0_PVAR12   = 1.33E-8    BC0_NVAR12 = 1.33E-8
+CC0_PVAR12   = 1.33E-4    CC0_NVAR12 = 1.33E-4
+DCGG_VAR8    = 0.05 

.LIB 'HLMC_55HV_MV8V_V1P12.LIB' VAR_CKT
.ENDL  VAR_FF  
***********************************
.LIB VAR_SS
.OPTION SCALE=1
.PARAM

+DCGG_PVAR12  = -0.05      DTOX_PVAR12 = 4.72E-11
+DCGG_NVAR12  = -0.05      DTOX_NVAR12 = 4.72E-11
+AC0_PVAR12   = 4.44E-15   AC0_NVAR12 = 4.44E-15 
+BC0_PVAR12   = 1.33E-8    BC0_NVAR12 = 1.33E-8 
+CC0_PVAR12   = 1.33E-4    CC0_NVAR12 = 1.33E-4 
+DCGG_VAR8    = -0.05 

.LIB 'HLMC_55HV_MV8V_V1P12.LIB' VAR_CKT
.ENDL  VAR_SS  
***********************************
.LIB VAR_MC
.OPTION SCALE=1
.PARAM

+DCGG_PVAR12  = ' 0.05      * SIGMA_MC_VAR '
+DTOX_PVAR12  = ' -4.72E-11 * SIGMA_MC_VAR '
+DCGG_NVAR12  = ' 0.05      * SIGMA_MC_VAR '
+DTOX_NVAR12  = ' -4.72E-11 * SIGMA_MC_VAR '
+AC0_PVAR12   = ' 4.44E-15  * SIGMA_MC_VAR ' 
+AC0_NVAR12   = ' 4.44E-15  * SIGMA_MC_VAR '
+BC0_PVAR12   = ' 1.33E-8   * SIGMA_MC_VAR ' 
+BC0_NVAR12   = ' 1.33E-8   * SIGMA_MC_VAR '
+CC0_PVAR12   = ' 1.33E-4   * SIGMA_MC_VAR ' 
+CC0_NVAR12   = ' 1.33E-4   * SIGMA_MC_VAR '
+DCGG_VAR8    = ' 0.05      * SIGMA_MC_VAR '

.LIB 'HLMC_55HV_MV8V_V1P12.LIB' VAR_CKT
.ENDL  VAR_MC 

.LIB VAR_CKT
********************************************************
*               1.2V NMOS IN NWELL VARACTOR            * 
********************************************************
*THIS MODEL IS EMPIRICAL MODEL, AND IS PROVIDED FOR SPECIAL CUSTOMER.
* 1=PORT1, 2=PORT2, WR=WIDTH, LR=LENGTH, MR=MULTIPLY NUMBER
.SUBCKT NVAR12_CKT 1 2 L=10U W=10U VAR_MISMATCH=1 MR=1 
.PARAM
+SCALE_VAR=1
+LRR='L*SCALE_VAR' WRR='W*SCALE_VAR'             
.PARAM
*** LOW FREQUENCY CAPACITOR
+A1_L0= 3307.896553 A2_L0= 1593.544978 C0_X0= 0.535791861
+A1_L1= 2427.98162 A2_L1= 2385.968074 C0_X1= 19.79363012
+A1_L2= -24.52887094 A2_L2= -410.840027 CGG_X0= -3.65222638
+A1_W0= 0.773755849 A2_W0= 0.342579379 CGG_DX= -1.51216403
+A1_C0= -0.726903615 A2_C0= -0.923460753 VC0= 0.907851664
+VC1= 0.19051317 CGG_TC= 0.000860975  
       
*
+CGG_A1=  '(A1_L2*(LRR*1E6)*(LRR*1E6)+A1_L1*(LRR*1E6)+A1_L0)*PWR((WRR*1E6),A1_W0*LOG10(LRR*1E6)+A1_C0)'
+CGG_A2=  '(A2_L2*(LRR*1E6)*(LRR*1E6)+A2_L1*(LRR*1E6)+A2_L0)*PWR((WRR*1E6),A2_W0*LOG10(LRR*1E6)+A2_C0)'
*
*** MISMATCH PARAMTERS
+DCGG_NVAR12MIS = 'VAR_MISMATCH*SIGMA_MIS_VAR*GEO_VAR'
+GEO_VAR = 'AC0_NVAR12/(WRR*LRR*MR)+BC0_NVAR12/SQRT(WRR*LRR*MR)+CC0_NVAR12'   
*
*** GATE CURRENT
+AR     = 'LRR*WRR'            
+TOX = '2.8E-009+DTOX_NVAR12'
+GCIE = 1.82152
+GCARC = 2.266361
+GCEVGC = 1.23496
+GCETC = 1.050354E3
+GCETE = 0.67324
+IGG_TC = 1.732E-3
*
*** EQUIVALENT CIRCUIT
*       
GG  1 2  CURRENT='(V(1,2)*PWR(ABS(V(1,2)),GCIE)*(GCARC*AR*EXP(GCEVGC*V(1,2)-GCETC*PWR(TOX,GCETE))))*2*(1+(TEMPER-25)*IGG_TC)' M=MR
CGG 1 2  C='MAX((1/(C0_X1+1/EXP(V(1,2)/C0_X0)))*(CGG_A2+(CGG_A1-CGG_A2)/(1+EXP((V(1,2)-CGG_X0)/(CGG_DX*(VC0+1/EXP(V(1,2)/VC1))*(CGG_TC*(TEMPER-25)+1)))))*(1+DCGG_NVAR12+DCGG_NVAR12MIS)*1E-15,1E-18)' M=MR
*
.ENDS NVAR12_CKT
*
********************************************************
*               1.2V PMOS IN PWELL VARACTOR            * 
********************************************************
*
.SUBCKT PVAR12_CKT 1 2 L=10U W=10U VAR_MISMATCH=1 MR=1 
.PARAM
+SCALE_VAR=1
+LRR='L*SCALE_VAR' WRR='W*SCALE_VAR'                  
*
.PARAM
*** LOW FREQUENCY CAPACITOR
+A1_L0= 2640.76087 A2_L0= 1484.450483 C0_X0= 0.504332115     
+A1_L1= 1255.258931 A2_L1= 1799.794977 C0_X1= 32.76633652     
+A1_L2= -9.828140287 A2_L2= -766.3195285 CGG_X0= -3.582883412
+A1_W0= 0.475180557 A2_W0= 0.198585412 CGG_DX= -1.1021061      
+A1_C0= -0.0120786 A2_C0= -0.733748368 VC0= 1.077650006     
+VC1= 0.220483551 CGG_TC= 0.000860975                          
         
*
+CGG_A1=  '(A1_L2*(LRR*1E6)*(LRR*1E6)+A1_L1*(LRR*1E6)+A1_L0)*PWR((WRR*1E6),A1_W0*LOG10(LRR*1E6)+A1_C0)'
+CGG_A2=  '(A2_L2*(LRR*1E6)*(LRR*1E6)+A2_L1*(LRR*1E6)+A2_L0)*PWR((WRR*1E6),A2_W0*LOG10(LRR*1E6)+A2_C0)'
*
*** MISMATCH PARAMTERS
+DCGG_PVAR12MIS = 'VAR_MISMATCH*SIGMA_MIS_VAR*GEO_VAR'
+GEO_VAR = 'AC0_PVAR12/(WRR*LRR*MR)+BC0_PVAR12/SQRT(WRR*LRR*MR)+CC0_PVAR12'   
*
*** GATE CURRENT
+AR     = 'LRR*WRR'            
+TOX     = '2.76E-009+DTOX_PVAR12' 
+GCIE = 1.951814
+GCARC = 0.18559
+GCEVGC = -0.824403
+GCETC = 972.089
+GCETE = 0.457181
+IGG_TC = 0.00274
*
*** EQUIVALENT CIRCUIT
*       
GG  1 2  CURRENT='(V(1,2)*PWR(ABS(V(1,2)),GCIE)*(GCARC*AR*EXP(GCEVGC*V(1,2)-GCETC*PWR(TOX,GCETE))))*2*(1+(TEMPER-25)*IGG_TC)' M=MR
CGG 1 2  C='MAX((1/(C0_X1+1/EXP((-1)*V(1,2)/C0_X0)))*(CGG_A2+(CGG_A1-CGG_A2)/(1+EXP(((-1)*V(1,2)-CGG_X0)/(CGG_DX*(VC0+1/EXP((-1)*V(1,2)/VC1))*(CGG_TC*(TEMPER-25)+1)))))*(1+DCGG_PVAR12+DCGG_PVAR12MIS)*1E-15,1E-18)' M=MR
* 
.ENDS PVAR12_CKT


********************************************************
*               8V NMOS IN NWELL VARACTOR            * 
********************************************************

.SUBCKT NVAR8_CKT 1 2 L=1E-6 W=1E-6 MR=1 VAR_MISMATCH=1
.PARAM
+SCALE_VAR = 1                     XL = -5E-008                     XW = 2E-008                    
+CGMIN_W = 1.231300E-010            CGMIN_L = 1.355900E-010        CGMIN_AREA = 6.046400E-4      
+DCG_W = -5.00000E-011              DCG_L = -1.000000E-011         DCG_AREA = 6.261900E-4        
+DVGS0 = -0.357018                 DVGS_TEMP = -3.931028E-4      VGNORM0 = 0.792181            
+VGNORM_TEMP = 9.196327E-4         AC0 = 3.862000E-013            BC0 = -5.221700E-010           
+CC0 = 0.014228   
+E  = 1.05 
+F  = 0.1         
.PARAM
+AREA = '(L*SCALE_VAR-XL)*(W*SCALE_VAR-XW)'
+CGMIN = 'CGMIN_W*2*(W*SCALE_VAR-XW)+CGMIN_L*2*(L*SCALE_VAR-XL)+CGMIN_AREA*AREA'
+DCG = 'DCG_W*1*2*(W*SCALE_VAR-XW)+DCG_L*2*(L*SCALE_VAR-XL)+DCG_AREA*AREA'
+DVGS = 'DVGS0+DVGS_TEMP*(TEMPER-25)' VGNORM = 'VGNORM0+VGNORM_TEMP*(TEMPER-25)'
+DCGG_MIS = 'GEO_VAR*SIGMA_MIS_VAR*VAR_MISMATCH'
+GEO_VAR = 'AC0/(W*SCALE_VAR*L*SCALE_VAR)+BC0/SQRT(W*SCALE_VAR*L*SCALE_VAR)+CC0'
CGG 1 2 C='MR*(1+DCGG_VAR8)*(CGMIN+DCG*(1.0+TANH(((V(1,2)*E+F)-DVGS)/VGNORM)))*(1+DCGG_MIS)'

.ENDS NVAR8_CKT



.ENDL VAR_CKT
