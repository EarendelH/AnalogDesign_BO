.SUBCKT P32S D G S B W=1E-6 L=1E-6 AS='AS_R' AD='AD_R' PS='PS_R' PD='PD_R' NRD='NRD_R' NRS='NRS_R' NF=1 MULTI=1 MISMATCH=1 GLOBAL_FLAG=0

