.ENDL SBD_SS

.LIB SBD_DIO
*
***********************************************************************************
*                                 1.2V SBD DIODE MODEL                            *
***********************************************************************************
.SUBCKT SBD_LV ANODE CATHODE AREA = 4E-12 PJ = 8E-6 MULTI=1     
.PARAM
+DW = 4.36E-7                 DL = 4.36E-7                  CJPWA = 1.5E-13               
+T1DR = -6.03666E-2           T2DR = 1.248463E-3            T3DR = -1.085347E-5           
+RSPWA = 3.1194E-14           RSPDNA = 5.28246E-11          RSPWR = 0.515775              
+RSPWDE = -3.4E-10            RSPDNDE = -5.6E-9     
+TEFF = 'EXP(T1DR*(TEMPER-25))+(TEMPER-25)*(T2DR+T3DR*(TEMPER-25))'
+RSPW = 'PWR(RSPWA*SQRT(AREA_PW),RSPWR)' 
+RSPDN = 'PWR(RSPDNA*SQRT(WEF*LEF),RSPWR)'
+W = 'PJ*0.25-0.5*PWR((0.25*PJ*PJ-4*AREA),0.5)'
+L = 'PJ*0.25+0.5*PWR((0.25*PJ*PJ-4*AREA),0.5)'                 
+WEF = 'W-2*DW'                
+LEF = 'L-2*DL'               
+W_PW = 'W+8E-6'               
+L_PW = 'L+8E-6'               
+AREA_PW = 'W_PW*L_PW-WEF*LEF' 
+PJ_PW = '2*W_PW+2*L_PW+2*WEF+2*LEF' 
+PJ_PWP = '2*WEF+2*LEF'        
+CJPW = 'CJPWA/AREA_PW'        
DCT ANODE CATHODE PDNW AREA='WEF*LEF' PJ='2*WEF+2*LEF' M=MULTI
DPW ANODE CATHODE PWDNW AREA=AREA_PW PJ=PJ_PW M=MULTI
DPWP ANODE CATHODE PWDNWP AREA=1E-15 PJ=PJ_PWP M=MULTI
*
.MODEL PWDNW D
***** FLAG PARAMETERS ***
+LEVEL = 3                     
***** DC MODEL PARAMETER ***
+IBV = 3.09E3                  IK = 8E5                      IKR = 1E10                    
+IS = '5.5E-7*PWR(2,DIS_SBD12)'                   
+JSW = '1.45E-14*PWR(2,DJSW_SBD12)'                
+N = '1*(1+DN_SBD12)'                         
+RS = '(1.42E-9+RSPW+RSPWDE)*(1+DRS_SBD12)'    
+BV = 14.2                     AREA = 3.24E-10               
+PJ = 7.2E-5                   
***** CAPACITANCE PARAMETER ***
+CJ = '(0.0007137+CJPW)*(1+DCJ_SBD12)'         PB = 0.878511                 MJ = 0.123108                 
+FC = 0                        FCS = 0                       CJSW = '1.88E-11*(1+DCJSW_SBD12)'                
+MJSW = 0.40764                PHP = 0.72                    
***** TEMPERATURE COEFFICIENT ***
+TLEV = 1                      TLEVC = 1                     TREF = 25                     
+EG = 1.16                     XTI = 3                       CTA = 9.36E-4                 
+CTP = 1E-4                    TCV = 0                       TPB = 1.47E-3                 
+TPHP = 1E-3                   TRS = 2.7E-3                  
*
.MODEL PWDNWP D
***** FLAG PARAMETERS ***
+LEVEL = 3                     
***** DC MODEL PARAMETER ***
+IBV = 3.09E3                  IK = 1E10                     IKR = 1E10                    
+IS = '1.998E-7*PWR(2,DIS_SBD12)'                 
+JSW = '1.45E-12*PWR(2,DJSW_SBD12)'                
+N = '1*(1+DN_SBD12)'                         
+RS = '1.42E-9*(1+DRS_SBD12)'                  
+BV = 14.2                      AREA = 3.24E-10               
+PJ = 7.2E-5                   
***** CAPACITANCE PARAMETER ***
+CJ = '6.39E-4*(1+DCJ_SBD12)'                  PB = 0.70475                  MJ = 0.33872                  
+FC = 0                        FCS = 0                       CJSW = '1.88E-11*(1+DCJSW_SBD12)'                
+MJSW = 0.40764                PHP = 0.72                    
***** TEMPERATURE COEFFICIENT ***
+TLEV = 1                      TLEVC = 1                     TREF = 25                     
+EG = 1.16                     XTI = 3                       CTA = 9.36E-4                 
+CTP = 1E-4                    TCV = 0                       TPB = 1.47E-3                 
+TPHP = 1E-3                   TRS = 1E-3                    
*
.MODEL PDNW D
***** FLAG PARAMETERS ***
+LEVEL = 3                     
***** DC MODEL PARAMETER ***
+IBV = 1E4                     IK = 2E8                      IKR = 1E10                    
+IS = '0.065*TEFF*PWR(2,DIS_SBD12)'             
+JSW = '1.45E-14*PWR(2,DJSW_SBD12)'                
+N = '1.04*(1+DN_SBD12)'                      
+RS = '(9.7E-9+RSPDN+RSPDNDE)*(1+DRS_SBD12)'   
+BV = 14.2                      AREA = 1E-10                  
+PJ = 6E-5                     
***** CAPACITANCE PARAMETER ***
+CJ = '2E-4*(1+DCJ_SBD12)'                     PB = 0.924472                 MJ = 0.889782                 
+FC = 0                        FCS = 0                       CJSW = '1.88E-11*(1+DCJSW_SBD12)'                
+MJSW = 0.059474               PHP = 0.49883                 
***** TEMPERATURE COEFFICIENT ***
+TLEV = 1                      TLEVC = 1                     TREF = 25                     
+EG = 1.16                     XTI = 3                       CTA = 9.36E-4                 
+CTP = 1E-4                    TCV = 0                       TPB = 1.47E-3                 
+TPHP = 1E-3                   TRS = 1E-3                    
.ENDS SBD_LV
*

***********************************************************************************
*                                 6V SBD DIODE MODEL                              *
***********************************************************************************
.SUBCKT SBD_HV ANODE CATHODE AREA = 4E-12 PJ = 8E-6 MULTI=1 
.PARAM
+DW = 9.2E-7                   DL = 9.2E-7                   T1DR = -3.96938E-2            
+T2DR = 1.872714E-3            T3DR = -1.472834E-5           RSPWA = 1.51112E-14           
+RSPDNA = 2.1132E-11           RSPWR = 0.49                  RSPWDE = -6.3E-10             
+RSPDNDE = -5.6E-9             T2NFR = -1.185568E-3          T3NFR = 9.859118E-7           
+W = 'PJ*0.25-0.5*PWR((0.25*PJ*PJ-4*AREA),0.5)'
+L = 'PJ*0.25+0.5*PWR((0.25*PJ*PJ-4*AREA),0.5)'             
+WEF = 'W-2*DW'                
+LEF = 'L-2*DL'                
+TEFF = 'EXP(T1DR*(TEMPER-25))+(TEMPER-25)*(T2DR+T3DR*(TEMPER-25))'
+TEFFNF = '1+(TEMPER-25)*(T2NFR+T3NFR*(TEMPER-25))'
+RSPW = 'PWR(RSPWA*SQRT(AREA_PDRIF),RSPWR)'
+RSPDN = 'PWR(RSPDNA*SQRT(WEF*LEF),RSPWR)'
+W_PDRIF = 'W+9E-6'            
+L_PDRIF = 'L+9E-6'            
+AREA_PDRIF = 'W_PDRIF*L_PDRIF-WEF*LEF-2*2.88E-6*2.88E-6'
+PJ_PDRIF = '2*(W_PDRIF-2*2.88E-6)+2*(L_PDRIF-2*2.88E-6)+8*2.88E-6*1.414+2*WEF+2*LEF'
+PJ_PDRIFP = '2*WEF+2*LEF'   
  
DCT ANODE CATHODE PDNW AREA='WEF*LEF' PJ='2*WEF+2*LEF' M=MULTI
DPDRIF ANODE CATHODE PDRIFDNW AREA=AREA_PDRIF PJ=PJ_PDRIF M=MULTI
DPDRIFP ANODE CATHODE PDRIFDNWP AREA=1E-15 PJ=PJ_PDRIFP M=MULTI

.MODEL PDRIFDNW D
