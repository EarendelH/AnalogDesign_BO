.LIB HV32S
.SUBCKT N32S D G S B W=1E-6 L=1E-6 AS='AS_R' AD='AD_R' PS='PS_R' PD='PD_R' NRD='NRD_R' NRS='NRS_R' NF=1 MULTI=1 MISMATCH=1 GLOBAL_FLAG=0

.PARAM
*****************DEFAULT INSTANCE************************
+DMCG_R = 1.23E-006
+DMCI_R = 2.1E-007
+XL_R = 0
+XW_R = 1.2E-006
+SA_R = 4.7E-007
+SB_R = 4.7E-007
+SD_R = '2*DMCG_R'
+AD_R = '(NF*DMCG_R+DMCI_R)*(W/NF+XW_R)' 
+AS_R = '(NF*DMCG_R+DMCI_R)*(W/NF+XW_R)'
+PD_R = '2*(NF*DMCG_R+DMCI_R)+(W/NF+XW_R)' 
+PS_R = '2*(NF*DMCG_R+DMCI_R)+(W/NF+XW_R)'
+NRD_R = 'DMCG_R/(W/NF+XW_R)/NF' 
+NRS_R = 'DMCG_R/(W/NF+XW_R)/NF'


.PARAM
+MISMATCH_HV32S = MISMATCH
+LEF='L'
