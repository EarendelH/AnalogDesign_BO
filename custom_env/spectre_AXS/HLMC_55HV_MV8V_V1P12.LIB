.LIB MVUD33
.SUBCKT N8UD33IO D G S B W=1E-6 L=1E-6 SA=0 SB=0 SD=0 AS=0 AD=0 PS=0 PD=0 NRD=0 NRS=0 SCA=0 SCB=0 SCC=0 NF=1 MULTI=1 MISMATCH=0 GLOBAL_FLAG=0
.PARAM

+GLOBAL_FLAG_MV33      =  GLOBAL_FLAG
+MISMATCH_MV33         =  MISMATCH
+LEF = 'L + (3E-009) - 2 * (0)'
+WEF = 'W + (2E-009) - 2 * (0)'
+GEO_FAC = '1 / SQRT(WEF * LEF * MULTI)'
+LCAL_VTH0_D_N = '(9.6E-009 * GL_1) * GEO_FAC * MISMATCH'
+LCAL_U0_D_N = '(5E-010 * GL_2) * GEO_FAC * MISMATCH'
+GL_RATIO_N8UD33 = 0.75

+DTOXE_N8UD33                =    'TL_DTOXE_N8UD33                 + GL_DTOXE_N8UD33 * GL_RATIO_N8UD33                 + MC_DTOXE_N8UD33 * GL_RATIO_N8UD33 * G1                '
+DXL_N8UD33                  =    'TL_DXL_N8UD33                   + GL_DXL_N8UD33 * GL_RATIO_N8UD33                   + MC_DXL_N8UD33 * GL_RATIO_N8UD33 * G1                  '
+DXW_N8UD33                  =    'TL_DXW_N8UD33                   + GL_DXW_N8UD33 * GL_RATIO_N8UD33                   + MC_DXW_N8UD33 * GL_RATIO_N8UD33 * G1                  '
+DCF_N8UD33                  =    'TL_DCF_N8UD33                   + GL_DCF_N8UD33 * GL_RATIO_N8UD33                   + MC_DCF_N8UD33 * GL_RATIO_N8UD33 * G1                  '
+DVTH0_N8UD33                =    'TL_DVTH0_N8UD33                 + GL_DVTH0_N8UD33 * GL_RATIO_N8UD33                 + MC_DVTH0_N8UD33 * GL_RATIO_N8UD33 * G1                 + LCAL_VTH0_D_N'
+DLVTH0_N8UD33               =    'TL_DLVTH0_N8UD33                + GL_DLVTH0_N8UD33 * GL_RATIO_N8UD33                + MC_DLVTH0_N8UD33 * GL_RATIO_N8UD33 * G1               '
+DWVTH0_N8UD33               =    'TL_DWVTH0_N8UD33                + GL_DWVTH0_N8UD33 * GL_RATIO_N8UD33                + MC_DWVTH0_N8UD33 * GL_RATIO_N8UD33 * G1               '
+DPVTH0_N8UD33               =    'TL_DPVTH0_N8UD33                + GL_DPVTH0_N8UD33 * GL_RATIO_N8UD33                + MC_DPVTH0_N8UD33 * GL_RATIO_N8UD33 * G1               '
+DU0_N8UD33                  =    'TL_DU0_N8UD33                   + GL_DU0_N8UD33 * GL_RATIO_N8UD33                   + MC_DU0_N8UD33 * GL_RATIO_N8UD33 * G1                   + LCAL_U0_D_N'
