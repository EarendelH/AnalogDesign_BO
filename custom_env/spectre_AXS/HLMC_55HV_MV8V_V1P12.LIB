.ENDS MOM24_3T
*
*
*******************************************************************************
*    55NM MOM CAPACITOR 3T FOR MOM25 (MOM STACKED FROM METAL 2 TO METAL 5)    *
*******************************************************************************
.SUBCKT MOM25_3T 1 2 B LR=5E-6 NF=10 MR=1 MOM_MISMATCH=1
.PARAM
+SCALE_MOM = 1.0
+C0 = 4.4E-10    VC1 = 4.5634E-06   VC2 =2.4846E-06 TC1 = 2.1138E-05
+LR_SHIFT = 2.4E-007    NF_SHIFT = -0.56    
*EQUIVALENT CIRCUIT
CAP 1 2 'MR*PWR(((LR*SCALE_MOM+LR_SHIFT)*(NF+NF_SHIFT)),0.995)*C0*(1+DMOM_C0)*(1+VC1*V(1,2)+VC2*V(1,2)*V(1,2))*(1+TC1*(TEMPER-25))+DC0_MIS'
*MISMATCH PARAMETER
.PARAM
+DC0_MIS=GEO_FAC*SIGMA_MIS_MOM*MOM_MISMATCH
+GEO_FAC='AC0*(1/(MR*NF*LR*SCALE_MOM))+BC0'
+AC0=1E-21
+BC0=1E-15

.ENDS MOM25_3T
