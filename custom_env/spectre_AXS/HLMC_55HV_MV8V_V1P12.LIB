*********************************************************************************************************************************************
.LIB HV32A
.SUBCKT N32A D G S B W=1E-6 L=1E-6 AS='AS_R' AD='AD_R' PS='PS_R' PD='PD_R' NRD='NRD_R' NRS='NRS_R' NF=1 MULTI=1 MISMATCH=1 GLOBAL_FLAG=0
.PARAM
*****************DEFAULT INSTANCE************************
+DMCG_R = 1.23E-006
+DMCI_R = 2.1E-007
+XL_R = 0
+XW_R = 0
+SA_R = 0
+SB_R = 0
+SD_R = '2*DMCG_R'
+AD_R = '(NF*DMCG_R+DMCI_R)*(W/NF+XW_R)' 
+AS_R = '(NF*DMCG_R+DMCI_R)*(W/NF+XW_R)'
+PD_R = '2*(NF*DMCG_R+DMCI_R)+(W/NF+XW_R)' 
+PS_R = '2*(NF*DMCG_R+DMCI_R)+(W/NF+XW_R)'
+NRD_R = 'DMCG_R/(W/NF+XW_R)/NF' 
+NRS_R = 'DMCG_R/(W/NF+XW_R)/NF'

.PARAM
+MISMATCH_HV32A = MISMATCH
+LEF='L'
+WEF='W/NF'
+ADTOXE_N32A = 1.0E-15            ADVTH_N32A = 3.5E-8           ADU0_N32A = 7.0E-10       
+ADXL_N32A = 0                    ADXW_N32A = 0                 ADPAGS_N32A = 1E-19

+GEO_FAC='1/SQRT(WEF*LEF*NF*MULTI)'
+DTOXE_N32A_LOCAL  = 'ADTOXE_N32A*GEO_FAC*SIGMA_MIS_A*MISMATCH_HV32A'
+DVTH_N32A_LOCAL   = 'ADVTH_N32A*GEO_FAC*SIGMA_MIS_B*MISMATCH_HV32A'
+DU0_N32A_LOCAL    = 'ADU0_N32A*GEO_FAC*SIGMA_MIS_C*MISMATCH_HV32A'
+DXL_N32A_LOCAL    = 'ADXL_N32A*GEO_FAC*SIGMA_MIS_D*MISMATCH_HV32A'
+DXW_N32A_LOCAL    = 'ADXW_N32A*GEO_FAC*SIGMA_MIS_E*MISMATCH_HV32A'
+DPAGS_N32A_LOCAL = 'ADPAGS_N32A*GEO_FAC*SIGMA_MIS_F*MISMATCH_HV32A'
+GL_RATIO_N32A   = 0.95

+DTOXE_N32A = 	'TL_DTOXE_N32A 	+ GL_DTOXE_N32A*GL_RATIO_N32A 	+ MC_DTOXE_N32A*GL_RATIO_N32A*G1 + DTOXE_N32A_LOCAL'
+DXL_N32A = 	'TL_DXL_N32A 	+ GL_DXL_N32A*GL_RATIO_N32A 	+ MC_DXL_N32A*GL_RATIO_N32A*G1 + DXL_N32A_LOCAL'
+DXW_N32A = 	'TL_DXW_N32A 	+ GL_DXW_N32A*GL_RATIO_N32A 	+ MC_DXW_N32A*GL_RATIO_N32A*G1 + DXW_N32A_LOCAL'
+DVTH_N32A = 	'TL_DVTH_N32A 	+ GL_DVTH_N32A*GL_RATIO_N32A 	+ MC_DVTH_N32A*GL_RATIO_N32A*G1 + DVTH_N32A_LOCAL'
+DLVTH0_N32A = 	'TL_DLVTH0_N32A + GL_DLVTH0_N32A*GL_RATIO_N32A 	+ MC_DLVTH0_N32A*GL_RATIO_N32A*G1'
+DLVSAT_N32A = 	'TL_DLVSAT_N32A + GL_DLVSAT_N32A*GL_RATIO_N32A 	+ MC_DLVSAT_N32A*GL_RATIO_N32A*G1'
+DVSAT_N32A = 	'TL_DVSAT_N32A + GL_DVSAT_N32A*GL_RATIO_N32A 	+ MC_DVSAT_N32A*GL_RATIO_N32A*G1'
+DAGS_N32A = 	'TL_DAGS_N32A 	+ GL_DAGS_N32A*GL_RATIO_N32A 	+ MC_DAGS_N32A*GL_RATIO_N32A*G1'

+DWVTH0_N32A = 	'TL_DWVTH0_N32A + GL_DWVTH0_N32A*GL_RATIO_N32A 	+ MC_DWVTH0_N32A*GL_RATIO_N32A*G1'
+DPVTH0_N32A = 	'TL_DPVTH0_N32A + GL_DPVTH0_N32A*GL_RATIO_N32A 	+ MC_DPVTH0_N32A*GL_RATIO_N32A*G1'
+DPVSAT_N32A = 	'TL_DPVSAT_N32A + GL_DPVSAT_N32A*GL_RATIO_N32A 	+ MC_DPVSAT_N32A*GL_RATIO_N32A*G1'
+DLAGS_N32A = 	'TL_DLAGS_N32A 	+ GL_DLAGS_N32A*GL_RATIO_N32A 	+ MC_DLAGS_N32A*GL_RATIO_N32A*G1'
+DU0_N32A = 	'TL_DU0_N32A 	+ GL_DU0_N32A*GL_RATIO_N32A 	+ MC_DU0_N32A*GL_RATIO_N32A*G1 + DU0_N32A_LOCAL'
+DLU0_N32A = 	'TL_DLU0_N32A 	+ GL_DLU0_N32A*GL_RATIO_N32A 	+ MC_DLU0_N32A*GL_RATIO_N32A*G1'
+DWUB_N32A = 	'TL_DWUB_N32A 	+ GL_DWUB_N32A*GL_RATIO_N32A 	+ MC_DWUB_N32A*GL_RATIO_N32A*G1'
+DPUB_N32A = 	'TL_DPUB_N32A 	+ GL_DPUB_N32A*GL_RATIO_N32A 	+ MC_DPUB_N32A*GL_RATIO_N32A*G1'
+DCGDO_N32A = 	'TL_DCGDO_N32A 	+ GL_DCGDO_N32A 	+ MC_DCGDO_N32A*G1'
+DCGSO_N32A = 	'TL_DCGSO_N32A 	+ GL_DCGSO_N32A 	+ MC_DCGSO_N32A*G1'
+DCJ_N32A = 	'TL_DCJ_N32A 	+ GL_DCJ_N32A 		+ MC_DCJ_N32A*G1'
+DCJSW_N32A = 	'TL_DCJSW_N32A 	+ GL_DCJSW_N32A 	+ MC_DCJSW_N32A*G1'
+DCJSWG_N32A = 	'TL_DCJSWG_N32A	+ GL_DCJSWG_N32A 	+ MC_DCJSWG_N32A*G1'
+DCGDL_N32A = 	'TL_DCGDL_N32A 	+ GL_DCGDL_N32A 	+ MC_DCGDL_N32A*G1'
+DCGSL_N32A = 	'TL_DCGSL_N32A 	+ GL_DCGSL_N32A 	+ MC_DCGSL_N32A*G1'
+DCF_N32A = 	'TL_DCF_N32A 	+ GL_DCF_N32A 	+ MC_DCF_N32A*G1'
+DWAGS_N32A = 	'TL_DWAGS_N32A 	+ GL_DWAGS_N32A*GL_RATIO_N32A 	+ MC_DWAGS_N32A*GL_RATIO_N32A*G1'
+DJTSSWGD_N32A ='TL_DJTSSWGD_N32A+ GL_DJTSSWGD_N32A*GL_RATIO_N32A+ MC_DJTSSWGD_N32A*GL_RATIO_N32A*G1'
+DPRDSW_N32A = 	'TL_DPRDSW_N32A 	+ GL_DPRDSW_N32A*GL_RATIO_N32A 	+ MC_DPRDSW_N32A*GL_RATIO_N32A*G1'
+DETA0_N32A = 	'TL_DETA0_N32A 	+ GL_DETA0_N32A*GL_RATIO_N32A 	+ MC_DETA0_N32A*GL_RATIO_N32A*G1'
+DLLETA0_N32A = 	'TL_DLLETA0_N32A 	+ GL_DLLETA0_N32A*GL_RATIO_N32A 	+ MC_DLLETA0_N32A*GL_RATIO_N32A*G1'
+DPPETA0_N32A = 	'TL_DPPETA0_N32A 	+ GL_DPPETA0_N32A*GL_RATIO_N32A 	+ MC_DPPETA0_N32A*GL_RATIO_N32A*G1'
+DPAGS_N32A = 	'TL_DPAGS_N32A 	+ GL_DPAGS_N32A*GL_RATIO_N32A 	+ MC_DPAGS_N32A*GL_RATIO_N32A*G1+DPAGS_N32A_LOCAL'
+DLAT_N32A = 	'TL_DLAT_N32A 	+ GL_DLAT_N32A*GL_RATIO_N32A 	+ MC_DLAT_N32A*GL_RATIO_N32A*G1'
+DPAT_N32A = 	'TL_DPAT_N32A 	+ GL_DPAT_N32A*GL_RATIO_N32A 	+ MC_DPAT_N32A*GL_RATIO_N32A*G1'



