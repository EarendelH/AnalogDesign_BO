RS S1 S 'RDS_P32*(1+TR1*DRTEMPER+TR2*DRTEMPER*DRTEMPER)*(1+PB1*MIN(10,MAX(0,V(B,S1)))+PB2*MIN(10,MAX(0,V(B,S1)))**2)' M='MULTI*NF/(25E-6-XWC_P32)*(WFINGER-XWC_P32)'
*RD D D1 1
*RS S1 S 1
FQSA D1 S1 CCCS POLY(2) VQSA VQSA2 SCALE='MULTI*NF*((WFINGER-XWC_P32)/(25E-6-XWC_P32))**WR_P32' 0 0 0 0 1
VQSA QSA2 S1 0
EQSA QSA1 S1  VOL='PP1*MAX(0,V(D1,D))+PP2*MAX(0,V(D1,D))**2+PP3*MAX(0,V(D1,D))**3+PP4*MAX(0,V(D1,D))**4+PP5*MAX(0,V(D1,D))**5+PP6*MAX(0,V(D1,D))**6+PP7*MAX(0,V(D1,D))**7+PP8*MAX(0,V(D1,D))**8+PP9*MAX(0,V(D1,D))**9+PP10*MAX(0,V(D1,D))**10'
+SCALE='1+TEX1*DRTEMPER+TEX2*DRTEMPER*DRTEMPER'
RQSA QSA1 QSA2 1 TC1=TRX1 TC2=TRX2
RQSA2 QSA3 QSA4 1
VQSA2 QSA4 S1 0
EQSA2 QSA3 S1 VOL='1+PE1*MAX(0,V(B,S1))+PE2*MAX(0,V(B,S1))**2'
GDR D1 D2 VCR POLY(1) D1 D SCALE='1+TGRD1*DRTEMPER+TGRD2*DRTEMPER*DRTEMPER' M='MULTI*NF/(25E-6-XWC_P32)*(WFINGER-XWC_P32)' 1 PG1 PG2 PG3 PG4 PG5

M1 D2 G S1 B P32A_MOS W=W L=L AS=AS AD=AD PS=PS PD=PD NRD=NRD NRS=NRS NF=NF M=MULTI 

