***************************************************************************
*                      MOM CAPACITANCE MODEL CARD                         *
***************************************************************************
*//	1=PORT1; 2=PORT2 
*//	MR:UNIT NUMBER IN NX MULTIPLE NY
*//	NF:FINGER NUMBER
*//	LR:OVERLAP REGION LENGTH
*
.LIB STAT_MOM
.PARAM
+SIGMA_MIS_MOM   = AGAUSS(0,1,1) 
+SIGMA_MC_MOMA   = AGAUSS(0,1,3) 
+SIGMA_MC_MOM    = SIGMA_MC_MOMA 
.ENDL STAT_MOM

.LIB MOM_TT
.PARAM
+DMOM_C0 = 0
.LIB 'HLMC_55HV_V1P1.LIB' MOM
.ENDL MOM_TT

.LIB MOM_FF
.PARAM
+DMOM_C0 = -0.05
.LIB 'HLMC_55HV_V1P1.LIB' MOM
.ENDL MOM_FF

.LIB MOM_SS

.PARAM
+DMOM_C0 = 0.05
.LIB 'HLMC_55HV_V1P1.LIB' MOM
.ENDL MOM_SS

.LIB MOM_MC

.PARAM
+DMOM_C0 = '-0.05*SIGMA_MC_MOM'
.LIB 'HLMC_55HV_V1P1.LIB' MOM
.ENDL MOM_MC

.LIB MOM
**
*******************************************************************************
*                         55NM MOM CAPACITOR  2-TERMINAL                      *
*******************************************************************************
*1=PORT1; 2=PORT2 
*******************************************************************************
*    55NM MOM CAPACITOR 2T FOR MOM12 (MOM STACKED FROM METAL 1 TO METAL 2)    *
*******************************************************************************
.SUBCKT MOM12 1 2 LR=5E-6 NF=10 MR=1 MOM_MISMATCH=1
.PARAM
+SCALE_MOM = 1.0
+C0 = 1.88E-10    VC1 = 1.1E-05   VC2 = 1E-06 TC1 = -4E-06
+LR_SHIFT = 2.9E-007    NF_SHIFT = -0.66    
*EQUIVALENT CIRCUIT
CAP 1 2 'MR*PWR(((LR*SCALE_MOM+LR_SHIFT)*(NF+NF_SHIFT)),0.99)*C0*(1+DMOM_C0)*(1+VC1*V(1,2)+VC2*V(1,2)*V(1,2))*(1+TC1*(TEMPER-25))+DC0_MIS'
*MISMATCH PARAMETER
.PARAM
+DC0_MIS=GEO_FAC*SIGMA_MIS_MOM*MOM_MISMATCH
+GEO_FAC='AC0*(1/(MR*NF*LR*SCALE_MOM))+BC0'
+AC0=1E-20
+BC0=1.2E-15

.ENDS MOM12
*******************************************************************************
*    55NM MOM CAPACITOR 2T FOR MOM13 (MOM STACKED FROM METAL 1 TO METAL 3)    *
*******************************************************************************
.SUBCKT MOM13 1 2 LR=5E-6 NF=10 MR=1 MOM_MISMATCH=1 
.PARAM
+SCALE_MOM = 1.0
+C0 = 2.88E-10    VC1 = 9.0995E-06   VC2 = 7.7518E-07 TC1 = -7.6136E-06
+LR_SHIFT = 2.9E-007    NF_SHIFT = -0.66    
*EQUIVALENT CIRCUIT
CAP 1 2 'MR*PWR(((LR*SCALE_MOM+LR_SHIFT)*(NF+NF_SHIFT)),0.99)*C0*(1+DMOM_C0)*(1+VC1*V(1,2)+VC2*V(1,2)*V(1,2))*(1+TC1*(TEMPER-25))+DC0_MIS'
*MISMATCH PARAMETER
.PARAM
+DC0_MIS=GEO_FAC*SIGMA_MIS_MOM*MOM_MISMATCH
+GEO_FAC='AC0*(1/(MR*NF*LR*SCALE_MOM))+BC0'
+AC0=1E-20
+BC0=9E-16

.ENDS MOM13
*
*******************************************************************************
*    55NM MOM CAPACITOR 2T FOR MOM14 (MOM STACKED FROM METAL 1 TO METAL 4)    *
*******************************************************************************
.SUBCKT MOM14 1 2 LR=5E-6 NF=10 MR=1 MOM_MISMATCH=1 
.PARAM
+SCALE_MOM = 1.0
+C0 = 4.08E-10    VC1 = 2.5437E-06   VC2 = 1.4611E-06 TC1 = -6.1193E-06
+LR_SHIFT = 2E-007    NF_SHIFT = -0.57    
*EQUIVALENT CIRCUIT
CAP 1 2 'MR*PWR(((LR*SCALE_MOM+LR_SHIFT)*(NF+NF_SHIFT)),0.989)*C0*(1+DMOM_C0)*(1+VC1*V(1,2)+VC2*V(1,2)*V(1,2))*(1+TC1*(TEMPER-25))+DC0_MIS'
*MISMATCH PARAMETER
.PARAM
+DC0_MIS=GEO_FAC*SIGMA_MIS_MOM*MOM_MISMATCH
+GEO_FAC='AC0*(1/(MR*NF*LR*SCALE_MOM))+BC0'
+AC0=3E-20
+BC0=1E-15

.ENDS MOM14
*
*******************************************************************************
*    55NM MOM CAPACITOR 2T FOR MOM15 (MOM STACKED FROM METAL 1 TO METAL 5)    *
*******************************************************************************
.SUBCKT MOM15 1 2 LR=5E-6 NF=10 MR=1 MOM_MISMATCH=1 
.PARAM
+SCALE_MOM = 1.0
+C0 = 5.2E-10    VC1 = 4.9976E-06   VC2 = 1.9359E-06 TC1 = 1.3794E-05
+LR_SHIFT = 2E-007    NF_SHIFT = -0.57    
*EQUIVALENT CIRCUIT
CAP 1 2 'MR*PWR(((LR*SCALE_MOM+LR_SHIFT)*(NF+NF_SHIFT)),0.99)*C0*(1+DMOM_C0)*(1+VC1*V(1,2)+VC2*V(1,2)*V(1,2))*(1+TC1*(TEMPER-25))+DC0_MIS'
*MISMATCH PARAMETER
.PARAM
+DC0_MIS=GEO_FAC*SIGMA_MIS_MOM*MOM_MISMATCH
+GEO_FAC='AC0*(1/(MR*NF*LR*SCALE_MOM))+BC0'
+AC0=1E-21
+BC0=1.1E-15
.ENDS MOM15
*
*******************************************************************************
*    55NM MOM CAPACITOR 2T FOR MOM16 (MOM STACKED FROM METAL 1 TO METAL 6)    *
*******************************************************************************
.SUBCKT MOM16 1 2 LR=5E-6 NF=10 MR=1 MOM_MISMATCH=1
.PARAM
+SCALE_MOM = 1.0
+C0 = 6.4E-10    VC1 = 3.7616E-06   VC2 = 8.7401E-07 TC1 = 4.0391E-05
+LR_SHIFT = 2.0E-007    NF_SHIFT = -0.57    
*EQUIVALENT CIRCUIT
CAP 1 2 'MR*PWR(((LR*SCALE_MOM+LR_SHIFT)*(NF+NF_SHIFT)),0.99)*C0*(1+DMOM_C0)*(1+VC1*V(1,2)+VC2*V(1,2)*V(1,2))*(1+TC1*(TEMPER-25))+DC0_MIS'
*MISMATCH PARAMETER
.PARAM
+DC0_MIS=GEO_FAC*SIGMA_MIS_MOM*MOM_MISMATCH
+GEO_FAC='AC0*(1/(MR*NF*LR*SCALE_MOM))+BC0'
+AC0=9E-19
+BC0=9E-16
.ENDS MOM16
*
*******************************************************************************
*    55NM MOM CAPACITOR 2T FOR MOM23 (MOM STACKED FROM METAL 2 TO METAL 3)    *
*******************************************************************************
.SUBCKT MOM23 1 2 LR=5E-6 NF=10 MR=1 MOM_MISMATCH=1
.PARAM
+SCALE_MOM = 1.0
+C0 = 2.05E-10    VC1 = 1.1325E-06   VC2 = 2.3320E-07 TC1 = -6.2180E-06
