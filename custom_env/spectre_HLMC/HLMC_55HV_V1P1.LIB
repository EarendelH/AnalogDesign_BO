.LIB MV60
.SUBCKT N6IO D G S B W=1E-6 L=1E-6 SA=0 SB=0 SD=0 AS=0 AD=0 PS=0 PD=0 NRD=0 NRS=0 SCA=0 SCB=0 SCC=0 NF=1 MULTI=1 MISMATCH=1 GLOBAL_FLAG=0 
.PARAM

+LEF='L'
+WEF='W/NF'
+GEO_FAC = '1 / SQRT(WEF * LEF * MULTI * NF)'
+LCAL_VTH0_D_N = '(9.5E-009 * GL_1) * GEO_FAC * MISMATCH'
+LCAL_U0_D_N = '(1E-012 * GL_2) * GEO_FAC * MISMATCH'
+GL_RATIO_N6IO = 0.75

+DTOXE_N6IO                =    'TL_DTOXE_N6IO                 + GL_DTOXE_N6IO * GL_RATIO_N6IO                 + MC_DTOXE_N6IO * GL_RATIO_N6IO * G1                '
+DXL_N6IO                  =    'TL_DXL_N6IO                   + GL_DXL_N6IO * GL_RATIO_N6IO                   + MC_DXL_N6IO * GL_RATIO_N6IO * G1                  '
+DXW_N6IO                  =    'TL_DXW_N6IO                   + GL_DXW_N6IO * GL_RATIO_N6IO                   + MC_DXW_N6IO * GL_RATIO_N6IO * G1                  '
