+JSW = '1.45E-14*PWR(2,DJSW_SBD12)'                
+N = '1*(1+DN_SBD12)'                         
+RS = '(1.42E-9+RSPW+RSPWDE)*(1+DRS_SBD12)'    
+BV = 14.2                     AREA = 3.24E-10               
+PJ = 7.2E-5                   
***** CAPACITANCE PARAMETER ***
+CJ = '(0.0007137+CJPW)*(1+DCJ_SBD12)'         PB = 0.878511                 MJ = 0.123108                 
+FC = 0                        FCS = 0                       CJSW = '1.88E-11*(1+DCJSW_SBD12)'                
+MJSW = 0.40764                PHP = 0.72                    
***** TEMPERATURE COEFFICIENT ***
