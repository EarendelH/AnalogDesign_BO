+DLVTH0_N6IO               =    'TL_DLVTH0_N6IO                + GL_DLVTH0_N6IO * GL_RATIO_N6IO                + MC_DLVTH0_N6IO * GL_RATIO_N6IO * G1               '
+DWVTH0_N6IO               =    'TL_DWVTH0_N6IO                + GL_DWVTH0_N6IO * GL_RATIO_N6IO                + MC_DWVTH0_N6IO * GL_RATIO_N6IO * G1               '
+DPVTH0_N6IO               =    'TL_DPVTH0_N6IO                + GL_DPVTH0_N6IO * GL_RATIO_N6IO                + MC_DPVTH0_N6IO * GL_RATIO_N6IO * G1               '
+DU0_N6IO                  =    'TL_DU0_N6IO                   + GL_DU0_N6IO * GL_RATIO_N6IO                   + MC_DU0_N6IO * GL_RATIO_N6IO * G1                   + LCAL_U0_D_N'
+DLU0_N6IO                 =    'TL_DLU0_N6IO                  + GL_DLU0_N6IO * GL_RATIO_N6IO                  + MC_DLU0_N6IO * GL_RATIO_N6IO * G1                 '
+DWU0_N6IO                 =    'TL_DWU0_N6IO                  + GL_DWU0_N6IO * GL_RATIO_N6IO                  + MC_DWU0_N6IO * GL_RATIO_N6IO * G1                 '
+DPU0_N6IO                 =    'TL_DPU0_N6IO                  + GL_DPU0_N6IO * GL_RATIO_N6IO                  + MC_DPU0_N6IO * GL_RATIO_N6IO * G1                 '
+DVSAT_N6IO                =    'TL_DVSAT_N6IO                 + GL_DVSAT_N6IO * GL_RATIO_N6IO                 + MC_DVSAT_N6IO * GL_RATIO_N6IO * G1                '
+DLVSAT_N6IO               =    'TL_DLVSAT_N6IO                + GL_DLVSAT_N6IO * GL_RATIO_N6IO                + MC_DLVSAT_N6IO * GL_RATIO_N6IO * G1               '
+DPVSAT_N6IO               =    'TL_DPVSAT_N6IO                + GL_DPVSAT_N6IO * GL_RATIO_N6IO                + MC_DPVSAT_N6IO * GL_RATIO_N6IO * G1               '
