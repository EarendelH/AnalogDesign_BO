************************************************************************************  
*        NON-SILICIDE N+ POLY HIGH RESISTOR 1K SUBCIRCUIT NETLIST (THREE TERMINAL)         *  
************************************************************************************ 
.SUBCKT RES_HRP1K N2 N1 SUB L=LR W=WR FLAG_CAP=0  
.PARAM
+RSH = '9.94E+02*(1+DRSH_HRP1K)'
+TC1R = -9.81E-05
+TC2R = 7.84E-07
+DW ='(5.5E-09+DDW_HRP1K)'
+DL = 1.50E-09
+JC1A = 0.00E+00
+JC1B = -1.00E-09
+JC2A = -7.30E-09
+JC2B = -8.00E-15

+WEFF = 'W-2*DW'    
+LEFF = 'L-2*DL'           
+RVC1 = 'JC1A + JC1B / LEFF'       
+RVC2 = '(JC2A + JC2B / LEFF) / LEFF'  
+TCOEF = '1.0+(TEMPER-25.0)*(TC1R+TC2R*(TEMPER-25.0))' 
+COX  = '1.265E-4+DCOX_HRP1K'  
+CAPSW   = '(7.745E-11+DCAPSW_HRP1K)*FLAG_CAP'

C1    N2 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF' 
R1    N2 N1 'RSH*LEFF/WEFF*TCOEF*MAX(1.0+RVC1*ABS(V(N2,N1))+RVC2*V(N2,N1)*V(N2,N1),0.85)'
C2    N1 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF'
.ENDS RES_HRP1K  

************************************************************************************  
*        NON-SILICIDE N+ POLY HIGH RESISTOR 2K SUBCIRCUIT NETLIST (THREE TERMINAL)         *  
************************************************************************************ 
.SUBCKT RES_HRP2K N2 N1 SUB L=LR W=WR FLAG_CAP=0   
.PARAM
+RSH = '1.99E+03*(1+DRSH_HRP2K)'
+TC1R = -9.62E-04
+TC2R = 1.92E-06
+DW ='( 5.50E-09+DDW_HRP2K)'
+DL = 4.80E-09
+JC1A = 0.00E+00
+JC1B = -1.00E-09
+JC2A = -6.00E-09
+JC2B = -8.00E-15
+WEFF = 'W-2*DW'     
+LEFF = 'L-2*DL'           
+RVC1 = 'JC1A + JC1B / LEFF'       
+RVC2 = '(JC2A + JC2B / LEFF) / LEFF'  
+TCOEF = '1.0+(TEMPER-25.0)*(TC1R+TC2R*(TEMPER-25.0))' 
+COX  = '1.265E-4+DCOX_HRP2K'  
+CAPSW   = '(7.745E-11+DCAPSW_HRP2K)*FLAG_CAP'
C1    N2 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF' 
R1    N2 N1 'RSH*LEFF/WEFF*TCOEF*MAX(1.0+RVC1*ABS(V(N2,N1))+RVC2*V(N2,N1)*V(N2,N1),0.85)'
C2    N1 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF'
.ENDS RES_HRP2K  

*********************************************************  
