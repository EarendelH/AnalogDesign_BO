+DCAPSW_PPO      = -6.61E-12 
+DCAPSW_NPOSAB   = -6.61E-12 
+DCAPSW_PPOSAB   = -6.61E-12  
+DCOX_HRP1K     = -1.072E-05
+DCOX_HRP2K     = -1.072E-05
+DCAPSW_HRP1K   = -6.61E-12 
+DCAPSW_HRP2K   = -6.61E-12  

*METAL RESISTOR
+DRSH_M1=0.05          DDW_M1=0.1            DCOX_M1=0.85              DCAPSW_M1=0.85
+DRSH_M2=0.06          DDW_M2=0.1            DCOX_M2=0.85              DCAPSW_M2=0.85
+DRSH_M3=0.06          DDW_M3=0.1            DCOX_M3=0.85              DCAPSW_M3=0.85
+DRSH_M4=0.06          DDW_M4=0.1            DCOX_M4=0.85              DCAPSW_M4=0.85
+DRSH_M5=0.06          DDW_M5=0.1            DCOX_M5=0.85              DCAPSW_M5=0.85
+DRSH_M6=0.06          DDW_M6=0.1            DCOX_M6=0.85              DCAPSW_M6=0.85
+DRSH_M7=0.06          DDW_M7=0.1            DCOX_M7=0.85              DCAPSW_M7=0.85
+DRSH_T2M1=0.01        DDW_T2M1=0.1          DCOX_T2M1=0.85            DCAPSW_T2M1=0.85
+DRSH_T4M1=0.01        DDW_T4M1=0.1          DCOX_T4M1=0.85            DCAPSW_T4M1=0.85
+DRSH_T4M2=0.01        DDW_T4M2=0.1          DCOX_T4M2=0.85            DCAPSW_T4M2=0.85
+DRSH_ALPA=0.01        DDW_ALPA=0.1          DCOX_ALPA=0.85            DCAPSW_ALPA=0.85
           
.LIB 'HLMC_55HV_V1P1.LIB' RESISTOR
.ENDL  RES_SS

.LIB RES_MC
.PARAM
*RESISTOR
+DRSH_NPO        = '-2.2311965*SIGMA_MC_R' 
+DRSH_PPO        = '-3.6289455*SIGMA_MC_R'  
+DRSH_NDIFSAB    = '-18.825*SIGMA_MC_R'
+DRSH_PDIFSAB    = '-38.55*SIGMA_MC_R'
+DRSH_NPOSAB     = '-30.6*SIGMA_MC_R'
+DRSH_PPOSAB     = '-120.3*SIGMA_MC_R'
+DDW_NPO         = '6.57738E-10*SIGMA_MC_R'
+DDW_PPO         = '-1E-09*SIGMA_MC_R'
+DDW_NDIFSAB     = '-1E-09*SIGMA_MC_R' 
+DDW_PDIFSAB     = '-1E-09*SIGMA_MC_R'  
+DDW_NPOSAB      = '-1E-09*SIGMA_MC_R'   
+DDW_PPOSAB      = '-1E-09*SIGMA_MC_R'      
+DRSH_HRP1K      ='-3.00E-01*SIGMA_MC_R'
+DRSH_HRP2K      ='-3.00E-01*SIGMA_MC_R'
+DDW_HRP1K       = '-1E-09*SIGMA_MC_R'   
+DDW_HRP2K       = '-1E-09*SIGMA_MC_R'      

*CAPACITOR
+DCOX_NPO        = '1.072E-05*SIGMA_MC_R' 
+DCOX_PPO        = '1.072E-05*SIGMA_MC_R' 
+DCOX_NPOSAB     = '1.072E-05*SIGMA_MC_R'
+DCOX_PPOSAB     = '1.072E-05*SIGMA_MC_R'
+DCAPSW_NPO      = '6.61E-12*SIGMA_MC_R' 
+DCAPSW_PPO      = '6.61E-12*SIGMA_MC_R' 
+DCAPSW_NPOSAB   = '6.61E-12*SIGMA_MC_R' 
+DCAPSW_PPOSAB   = '6.61E-12*SIGMA_MC_R'
+DCOX_HRP1K      = '1.072E-05*SIGMA_MC_R'
+DCOX_HRP2K      = '1.072E-05*SIGMA_MC_R'
+DCAPSW_HRP1K    = '6.61E-12*SIGMA_MC_R' 
+DCAPSW_HRP2K    = '6.61E-12*SIGMA_MC_R'

*METAL RESISTOR
+DRSH_M1='-0.05*SIGMA_MC_R'         DDW_M1='-0.1*SIGMA_MC_R'           DCOX_M1='1+0.15*SIGMA_MC_R'              DCAPSW_M1='1+0.15*SIGMA_MC_R'
+DRSH_M2='-0.048*SIGMA_MC_R'        DDW_M2='-0.1*SIGMA_MC_R'           DCOX_M2='1+0.15*SIGMA_MC_R'              DCAPSW_M2='1+0.15*SIGMA_MC_R'
+DRSH_M3='-0.048*SIGMA_MC_R'        DDW_M3='-0.1*SIGMA_MC_R'           DCOX_M3='1+0.15*SIGMA_MC_R'              DCAPSW_M3='1+0.15*SIGMA_MC_R'
+DRSH_M4='-0.048*SIGMA_MC_R'        DDW_M4='-0.1*SIGMA_MC_R'           DCOX_M4='1+0.15*SIGMA_MC_R'              DCAPSW_M4='1+0.15*SIGMA_MC_R'
+DRSH_M5='-0.048*SIGMA_MC_R'        DDW_M5='-0.1*SIGMA_MC_R'           DCOX_M5='1+0.15*SIGMA_MC_R'              DCAPSW_M5='1+0.15*SIGMA_MC_R'
+DRSH_M6='-0.048*SIGMA_MC_R'        DDW_M6='-0.1*SIGMA_MC_R'           DCOX_M6='1+0.15*SIGMA_MC_R'              DCAPSW_M6='1+0.15*SIGMA_MC_R'
+DRSH_M7='-0.048*SIGMA_MC_R'        DDW_M7='-0.1*SIGMA_MC_R'           DCOX_M7='1+0.15*SIGMA_MC_R'              DCAPSW_M7='1+0.15*SIGMA_MC_R'
+DRSH_T2M1='-0.01*SIGMA_MC_R'       DDW_T2M1='-0.1*SIGMA_MC_R'         DCOX_T2M1='1+0.15*SIGMA_MC_R'            DCAPSW_T2M1='1+0.15*SIGMA_MC_R'
+DRSH_T4M1='-0.01*SIGMA_MC_R'       DDW_T4M1='-0.1*SIGMA_MC_R'         DCOX_T4M1='1+0.15*SIGMA_MC_R'            DCAPSW_T4M1='1+0.15*SIGMA_MC_R'
+DRSH_T4M2='-0.01*SIGMA_MC_R'       DDW_T4M2='-0.1*SIGMA_MC_R'         DCOX_T4M2='1+0.15*SIGMA_MC_R'            DCAPSW_T4M2='1+0.15*SIGMA_MC_R'
+DRSH_ALPA='-0.01*SIGMA_MC_R'       DDW_ALPA='-0.1*SIGMA_MC_R'         DCOX_ALPA='1+0.15*SIGMA_MC_R'            DCAPSW_ALPA='1+0.15*SIGMA_MC_R'


.LIB 'HLMC_55HV_V1P1.LIB' RESISTOR
.ENDL RES_MC


.LIB RESISTOR



************************************************************************************  
*                 SILICIDE N+ POLY RESISTOR SUBCIRCUIT NETLIST                     *  
************************************************************************************ 
.SUBCKT RES_NPO N2 N1 SUB L=LR W=WR FLAG_CAP=1 RES_MISMATCH = 1
.PARAM  

.PARAM
*****MISMATCH PARAMETERS*****
+SCALE=1    WEFF = 'W*SCALE-2*DW'    LEFF = 'L*SCALE-2*DL'

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =0.704E-7
************
+RSH = '(11.1559826+DRSH_NPO)+RSHMIS'               DW = '6.577E-09+DDW_NPO'       DL = -4.104E-07                      
+RVC0 = 8.300E-11                RVC1 = 2.819E-5            RVC2 = 4.833E-13                       
+TC1R = 1.817E-03                TC2R = -2.115E-07   

+RO = 'RSH*(L*SCALE-2*DL)/(W*SCALE-2*DW)'  RVC = 'MAX(0,(RVC0 + RVC1 * W *SCALE+ RVC2 * (L/W))/(L*SCALE-2*DL)/(L*SCALE-2*DL))'
+TCOEF(TEMPER) = '1.0+(TEMPER-25.0)*(TC1R+TC2R*(TEMPER-25.0))'  

+COX      = '1.264E-4+DCOX_PPO'              CAPSW   = '(7.745E-11+DCAPSW_PPO)*FLAG_CAP'

C1 N2 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L' 
R1 N2 N1 'TCOEF(TEMPER)*RO*(1.5-1/(2+RVC*V(N2,N1)*V(N2,N1)))' 
C2 N1 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L'

.ENDS RES_NPO 

************************************************************************************  
*                 SILICIDE P+ POLY RESISTOR SUBCIRCUIT NETLIST                     *  
************************************************************************************ 
.SUBCKT RES_PPO N2 N1 SUB L=LR W=WR FLAG_CAP=1 RES_MISMATCH = 1
.PARAM

+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =3.25E-7
  
+RSH      = '( 12.096485+DRSH_PPO)+RSHMIS'      RTC1   = 2.2E-3       RTC2 = -6.24388E-7   
+DW       = '( -4.2E-09+DDW_PPO) -7.79429E-9'     DL   = -2.636906E-6
+JC1A = 2E-3 JC1B = -9.65E-7
+JC2A = 1.804E-7 JC2B = 1.3065E-11
+RVC1     = 'JC1A+JC1B/L'          RVC2   = '(JC2A+JC2B/L)/L'          
+WEFF     = 'W-2*DW'           LEFF   = 'L-2*DL'
+TCOEF     = '1.0+(TEMPER-25.0)*(RTC1+RTC2*(TEMPER-25.0))' 
+COX      = '1.264E-4+DCOX_PPO'              CAPSW   = '(7.745E-11+DCAPSW_PPO)*FLAG_CAP'

C1 N2 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L' 
R1 N2 N1 'RSH*LEFF/WEFF*TCOEF*MIN(1.0+RVC1*ABS(V(N2,N1))+RVC2*V(N2,N1)*V(N2,N1), 1.6)'  
C2 N1 SUB 'COX*WEFF*L/2+CAPSW*WEFF+CAPSW*L'
.ENDS RES_PPO 

************************************************************************************  
*           NON-SILICIDE N+ DIFFUSION RESISTOR SUBCIRCUIT NETLIST                  *  
************************************************************************************ 
.SUBCKT RES_NDIFSAB N2 N1 SUB L=LR W=WR  RES_MISMATCH = 1
.PARAM  
+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =2.68E-6


+RSH      = '( 125.5+DRSH_NDIFSAB)+RSHMIS'  RTC1   = 1.5E-3      RTC2 = 8.1E-07   
+DW       = '( -5.2E-09+DDW_NDIFSAB) + 5.4E-9'   DL   = -1.26038E-7
+JC1A = 1.01E-3 JC1B = 7.51E-11
+JC2A = 2.00925E-8 JC2B = 3.27E-14
+RVC1     = 'JC1A+JC1B/L'           RVC2   = '(JC2A+JC2B/L)/L' 
+WEFF     = 'W-2*DW'                LEFF   = 'L-2*DL'
+TCOEF     = '1.0+(TEMPER-25.0)*(RTC1+RTC2*(TEMPER-25.0))' 

D1    SUB  N2 NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'  
R1    N2   NB 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D2    SUB  NB NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R2    NB   NC 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D3    SUB  NC NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R3    NC   ND 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D4    SUB  ND NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R4    ND   N1 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D5    SUB  N1 NDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'  
.ENDS RES_NDIFSAB   

************************************************************************************  
*               NON-SILICIDE P+ DIFFUSION RESISTOR SUBCIRCUIT NETLIST              *  
************************************************************************************ 
.SUBCKT RES_PDIFSAB N2 N1 SUB L=LR W=WR RES_MISMATCH = 1
.PARAM  
+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =3.1E-6

+RSH      = '( 257+DRSH_PDIFSAB)+RSHMIS'   RTC1   = 1.5E-03       RTC2 = 1.4E-06   
+DW       = '( -2.2E-8+DDW_PDIFSAB) + 1.89E-8'    DL   = -1.0725E-7
+JC1A = -2.73E-04 JC1B = 1.56E-10
+JC2A = 8.8E-9 JC2B = 2.28E-14
+RVC1     = 'JC1A+JC1B/L'            RVC2   = '(JC2A+JC2B/L)/L' 
+WEFF     = 'W-2*DW'                 LEFF   = 'L-2*DL'
+TCOEF     = '1.0+(TEMPER-25.0)*(RTC1+RTC2*(TEMPER-25.0))' 

D1    N2   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'
R1    N2   NA 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D2    NA   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R2    NA   NB 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D3    NB   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R3    NB   NC 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D4    NC   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='2*(L-2*DL)/5'
R4    NC   N1 'RSH*LEFF/4/WEFF*TCOEF*MIN(1.0+RVC1*V(N2,N1)+RVC2*V(N2,N1)*V(N2,N1),2)'
D5    N1   SUB PDIO12 AREA='(W-2*DW)*(L-2*DL)/5' PJ='(W-2*DW)+2*(L-2*DL)/5'
.ENDS RES_PDIFSAB 

************************************************************************************  
*        NON-SILICIDE N+ POLY RESISTOR SUBCIRCUIT NETLIST (THREE TERMINAL)         *  
************************************************************************************ 
.SUBCKT RES_NPOSAB N2 N1 SUB L=LR W=WR FLAG_CAP=1    RES_MISMATCH = 1
.PARAM
+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =7.7E-6

+RSH = '( 170+DRSH_NPOSAB)+RSHMIS'
+TC1R =-5.5E-5 
+TC2R = 2E-7
+DW ='( 3.8E-008+DDW_NPOSAB)'
+DL =2.2E-8
+JC1A = 5E-5
+JC1B = -2E-9
+JC2A = -3E-9
+JC2B = 1E-15
+WEFF = 'W-2*DW'     
+LEFF = 'L-2*DL'           
+RVC1 = 'JC1A + JC1B / LEFF'       
+RVC2 = '(JC2A + JC2B / LEFF) / LEFF'  
+TCOEF = '1.0+(TEMPER-25.0)*(TC1R+TC2R*(TEMPER-25.0))' 
+COX  = '1.265E-4+DCOX_NPOSAB'  
+CAPSW   = '(7.745E-11+DCAPSW_NPOSAB)*FLAG_CAP'
C1    N2 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF' 
R1    N2 N1 'RSH*LEFF/WEFF*TCOEF*MAX(1.0+RVC1*ABS(V(N2,N1))+RVC2*V(N2,N1)*V(N2,N1),0.85)'
C2    N1 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF'
.ENDS RES_NPOSAB  

************************************************************************************  
*        NON-SILICIDE P+ POLY RESISTOR SUBCIRCUIT NETLIST (THREE TERMINAL)         *  
************************************************************************************ 
.SUBCKT RES_PPOSAB N2 N1 SUB L=LR W=WR FLAG_CAP=1 RES_MISMATCH = 1
.PARAM
+RSHMIS = 'ARSH*GEO_FAC*SIGMA_MIS_R*RES_MISMATCH'
+GEO_FAC = '1/SQRT(WEFF*LEFF)'
+ARSH =8.595E-6
+ RSH = '( 802+DRSH_PPOSAB)+RSHMIS'
+ TC1R = -4.1E-4
+ TC2R = 2.5E-7
+ DW = '( 1.7E-8+DDW_PPOSAB)'
+ DL =1.5E-8
+ JC1A = 6E-4
+ JC1B = -1E-9
+ JC2A = -1E-8
+ JC2B = 1E-15
+ WEFF = 'W-2*DW'     
+ LEFF = 'L-2*DL'           
+ RVC1 = 'JC1A + JC1B / LEFF'       
+ RVC2 = '(JC2A + JC2B / LEFF) / LEFF'  
+ TCOEF = '1.0+(TEMPER-25.0)*(TC1R+TC2R*(TEMPER-25.0))'
+COX = '1.265E-4+DCOX_PPOSAB' 
+CAPSW = '(7.745E-11+DCAPSW_PPOSAB)*FLAG_CAP'
C1    N2 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF' 
R1    N2 N1 'RSH*LEFF/WEFF*TCOEF*MAX(1.0+RVC1*ABS(V(N2,N1))+RVC2*V(N2,N1)*V(N2,N1),0.9)'
C2    N1 SUB 'COX*WEFF*LEFF/2+CAPSW*WEFF+CAPSW*LEFF'
.ENDS RES_PPOSAB 

