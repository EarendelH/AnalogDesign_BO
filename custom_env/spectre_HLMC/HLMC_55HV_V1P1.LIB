.LIB 'HLMC_55HV_V1P1.LIB' SBD_DIO
.ENDL SBD_SS

.LIB SBD_DIO
*
***********************************************************************************
*                                 1.2V SBD DIODE MODEL                            *
***********************************************************************************
.SUBCKT SBD_LV ANODE CATHODE AREA = 4E-12 PJ = 8E-6 MULTI=1     
.PARAM
+DW = 4.36E-7                 DL = 4.36E-7                  CJPWA = 1.5E-13               
+T1DR = -6.03666E-2           T2DR = 1.248463E-3            T3DR = -1.085347E-5           
+RSPWA = 3.1194E-14           RSPDNA = 5.28246E-11          RSPWR = 0.515775              
+RSPWDE = -3.4E-10            RSPDNDE = -5.6E-9     
+TEFF = 'EXP(T1DR*(TEMPER-25))+(TEMPER-25)*(T2DR+T3DR*(TEMPER-25))'
+RSPW = 'PWR(RSPWA*SQRT(AREA_PW),RSPWR)' 
+RSPDN = 'PWR(RSPDNA*SQRT(WEF*LEF),RSPWR)'
+W = 'PJ*0.25-0.5*PWR((0.25*PJ*PJ-4*AREA),0.5)'
+L = 'PJ*0.25+0.5*PWR((0.25*PJ*PJ-4*AREA),0.5)'                 
+WEF = 'W-2*DW'                
+LEF = 'L-2*DL'               
+W_PW = 'W+8E-6'               
+L_PW = 'L+8E-6'               
+AREA_PW = 'W_PW*L_PW-WEF*LEF' 
+PJ_PW = '2*W_PW+2*L_PW+2*WEF+2*LEF' 
+PJ_PWP = '2*WEF+2*LEF'        
+CJPW = 'CJPWA/AREA_PW'        
DCT ANODE CATHODE PDNW AREA='WEF*LEF' PJ='2*WEF+2*LEF' M=MULTI
DPW ANODE CATHODE PWDNW AREA=AREA_PW PJ=PJ_PW M=MULTI
DPWP ANODE CATHODE PWDNWP AREA=1E-15 PJ=PJ_PWP M=MULTI
