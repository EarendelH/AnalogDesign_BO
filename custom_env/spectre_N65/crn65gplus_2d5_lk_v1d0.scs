+ 2) * (cmimbb2p0_mimfac)) cmim_para=(1 + factmis) * (((wt + mim_a) * (lt + mim_a) 
+ * 1e12 * mim_b) + 2 * ((wt + mim_a) + (lt + mim_a)) * 1e6 * mim_c) * 1e-15 * 
+ (1 + (temp - 25) * tcc1 + (temp - 25) * (temp - 25) * tcc2) 
