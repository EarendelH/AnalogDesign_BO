section mos
// *********************************************************************************************
//                                                                            
//                   *
//                                1.0V STD-VT NMOS DEVICE MODELS              
//                   *
//                                                                            
//                   *
// *********************************************************************************************
 
// *********************************
//        Mismatch   model         *
// *********************************
inline subckt nch_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=7.15e-008 xw= + 1.6e-08 
+ + dxwn ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / factor * (w 
+ / nf + xw / factor) pd=4 * dmcg / factor + 2 * (w / nf + xw / factor) ps=4 * dmcg 
