inline subckt nch_lvt_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=7.15e-008 xw= + 1.6e-08 
+ + dxwn_lvt ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / factor 
+ * (w / nf + xw / factor) pd=4 * dmcg / factor + 2 * (w / nf + xw / factor) ps=4 
+ * dmcg / factor + 2 * (w / nf + xw / factor) nrd=dmcg / factor / (w / nf + xw 
+ / factor) nrs=dmcg / factor / (w / nf + xw / factor) sa=0.405e-6 / factor sb=0.405e-6 
+ / factor sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor 
+ mismatchflag=1 temp1=parn1_lvt temp2=parn2_lvt fac1=0.328109 * temp1 * sigma + 
+ 0.944640 * temp2 * sigma fac2=0.328109 * temp1 * sigma - 0.944640 * temp2 * sigma 
+ lef=l * factor - 1.46e-08 wef=w / nf * factor + 1.6e-08 geo_fac=1 / sqrt(multi 
+ * nf * lef * wef * 1e12) vthmisn_lvt=0.00215800 * geo_fac * fac1 * mismatchflag 
+ dlmisn_lvt=0.00229596 * geo_fac * lef * fac2 * mismatchflag dwmisn_lvt= - 0.00229596 
+ * geo_fac * wef * fac2 * mismatchflag toxmisn_lvt=0.00229596 * geo_fac * toxn_lvt 
+ * fac2 * mismatchflag tnoiax=1.603e05 / (l * 1e6) + 2.013e07 rnoiax=0.011 / (l * 1e6) + 0.4433
nch_lvt_mac ( n1 n2 n3 n4 ) nch_lvt w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
