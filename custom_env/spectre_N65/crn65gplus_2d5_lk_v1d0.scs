//  *************************     COMMON STATISTICAL LIBRARY      ***************************

section stat_res
parameters random1_res=0
parameters random2_res=0
parameters random3_res=0
parameters random4_res=0
parameters par1_res=random1_res
parameters par2_res=random2_res
parameters par3_res=random3_res
parameters par4_res=random4_res
parameters par_res=0

statistics {
    process {
        vary random1_res dist=gauss std=1/3
        vary random2_res dist=gauss std=1/3
        vary random3_res dist=gauss std=1/3
        vary random4_res dist=gauss std=1/3
        }
    }
endsection stat_res
 
//  *************************     LIBRARY OF STATISTICAL CASE     ***************************
 
 

