//                                                                         *
//  ************************************************************************

section mos_cap
ahdl_include "mosCap_ahdl.va"
subckt nmoscap ( ng nds ) 
parameters factor=1.0 lr=5e-6 wr=5e-6 toxa=toxm_var * 0.88 + 0.5 weff=wr * factor + 0.8e-9 + 
+ dxw_var leff=lr * factor - 6.5e-8 + 1.0e-14 / wr / factor + dxl_var rvalue=rs0_var 
+ * (1.0 - 4.0e-7 / wr / factor - 2.0e-7 / lr / factor) eff=wr * factor * lr * factor 
+ * (1.0 + 1.6e-3 * (temp - 25)) * 9393.931 / toxa / toxa / toxa * 5.6 * fac_var 
+ phit=(temp + 273.0) / 11606.0 as=sqrt(ndep0_var * (1.0 + 3.0e-7 / lr / factor 
+ + 3.0e-7 / wr / factor + pndep_var / wr / factor / lr / factor) * 3.8850499 / (temp 
+ + 273.0)) * toxa / 3.399936 as2=as * as a0=1.0 / (1.0 + 0.707106781186547 * as) 
+ vfb=(0.05 + 5.0e-9 / wr / factor + 4.0e-9 / lr / factor - 1.8e-14 / lr / factor 
+ / wr / factor) * (1.0 + (temp - 25.0) * 7.5e-3) 
cg ( ng n1 ) mosCap toxa=toxa weff=weff leff=leff as=as as2=as2 phit=phit a0=a0 vfb=vfb
gdf1 ( ng n1 ) bsource i =eff * (1.34e4 * (pow(0.5 * (sqrt(v(ng,n1) * v(ng,n1) + 
+ 1.0e-4) + v(ng,n1)),4.0) - pow(5.0e-3,4.0)) - 150 * (pow(0.5 * (sqrt(v(ng,n1) 
+ * v(ng,n1) + 1.0e-4) - v(ng,n1)),1.8) - pow(5.0e-3,1.8)) + 150.0 * v(ng,n1))
rs ( n1 nds ) resistor r=rvalue
ends nmoscap
endsection mos_cap
 

