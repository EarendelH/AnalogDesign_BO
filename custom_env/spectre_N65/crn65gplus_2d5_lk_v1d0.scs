// *********************************
//        Mismatch   model         *
// *********************************
inline subckt pch_hvt_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=7e-008 xw= + 1.6e-08 
+ + dxwp_hvt ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / factor 
+ * (w / nf + xw / factor) pd=4 * dmcg / factor + 2 * (w / nf + xw / factor) ps=4 
+ * dmcg / factor + 2 * (w / nf + xw / factor) nrd=dmcg / factor / (w / nf + xw 
+ / factor) nrs=dmcg / factor / (w / nf + xw / factor) sa=0.405e-6 / factor sb=0.405e-6 
+ / factor sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor 
+ mismatchflag=1 temp1=parp1_hvt temp2=parp2_hvt fac1=0.818524 * temp1 * sigma + 
+ 0.574472 * temp2 * sigma fac2=0.818524 * temp1 * sigma - 0.574472 * temp2 * sigma 
+ lef=l * factor - 1.09e-08 wef=w / nf * factor + 1.6e-08 geo_fac=1 / sqrt(multi 
+ * nf * lef * wef * 1e12) vthmisp_hvt=0.00211701 * geo_fac * fac1 * mismatchflag 
+ dlmisp_hvt=0.00169085 * geo_fac * lef * fac2 * mismatchflag dwmisp_hvt= - 0.00169085 
