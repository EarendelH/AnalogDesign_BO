//  13)	RF RESISTOR MODEL
// 	
//       	Model name	
//  ----------------------------------------------------------------------
//  rppolyl_rf       P+Poly w/i silicide  2um<=W<=10um,  0.3um<=L<=150um, 1<=sqr<=150
//  rppolys_rf       P+Poly w/i silicide  0.15um<=W<2um,  0.3um<=L<=150um, 1<=sqr<=150
//  rppolywo_rf	     P+Poly w/o silicide  0.4um<=W<=10um,  0.8um<=L<=25um, 1<=sqr<=20
//  ************************************************************************************************

section rf_res_sa
subckt rppolyl_rf ( hi lo gnode ) 
parameters l=20u w=5u mismatchflag=0 geo_fac=1 / sqrt(l * w * 1e12) factmis=0.0113 
+ * geo_fac * par_rfres_sa * mismatchflag rsh=rppolylrf * (1 + factmis) dw=-0.01549u 
+ pvc1=3.53e-07 pvc2=7.56e-12 ptc1=0.00230054 ptc2=-3.32e-06  pt=temp tfac=1.0 + ptc1 
+ * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt - 25.0) rsubtfac=1.0 + 3.74m * (pt - 
+ 25.0) + 9.1u * (pt - 25.0) * (pt - 25.0) rsubx=277 / ((1 / (0.5u + (l + 0.24u) / 
+ 6) * (w - dw)) + (1 / (3u + (w - dw) / 6) * (l + 0.24u))) * rsubtfac ca=ca_pofoxrf 
+ cf=cf_polfoxrf 
rend1 ( hi 1 ) resistor r=22 / (int(abs((w - 0.016u) / 0.22u) + 1))
ls1 ( 1 12 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
r1 ( 12 2 ) bsource r=1 / 6 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
ls2 ( 2 23 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
r2 ( 23 3 ) bsource r=1 / 3 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
ls3 ( 3 34 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
r3 ( 34 4 ) bsource r=1 / 3 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
r4 ( 4 45 ) bsource r=1 / 6 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
ls4 ( 45 5 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
rend2 ( 5 lo ) resistor r=22 / (int(abs((w - 0.016u) / 0.22u) + 1))
cox1 ( 2 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.24u) * 1e+12 + cf * 2 * (w + l 
+ + 0.24u) * 1e+6)
cox2 ( 3 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.24u) * 1e+12 + cf * 2 * (w + l 
+ + 0.24u) * 1e+6)
cox3 ( 4 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.24u) * 1e+12 + cf * 2 * (w + l 
+ + 0.24u) * 1e+6)
rsub ( 6 gnode ) resistor r=rsubx * sarsub_fac
csub ( 6 gnode ) capacitor c=85f / rsubx * sacsub_fac
ends rppolyl_rf

subckt rppolys_rf ( hi lo gnode ) 
parameters l=20u w=1u mismatchflag=0 geo_fac=1 / sqrt(l * w * 1e12) factmis=0.0113 
+ * geo_fac * par_rfres_sa * mismatchflag rsh=rppolysrf * (1 + factmis) dw= - 0.01549u 
+ + dxw_rppolysrf pvc1=4.28e-08 pvc2=7.04e-13 ptc1=0.002614034 ptc2=-5.37e-06 pt=temp 
+ tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt - 25.0) rsubtfac=1.0 
+ + 3.74m * (pt - 25.0) + 9.1u * (pt - 25.0) * (pt - 25.0) rsubx=277 / ((1 / (0.5u 
+ + (l + 0.24u) / 6) * (w - dw)) + (1 / (3u + (w - dw) / 6) * (l + 0.24u))) * rsubtfac 
+ ca=ca_pofoxrf cf=cf_posfoxrf 
rend1 ( hi 1 ) resistor r=22 / (int(abs((w - 0.016u) / 0.22u) + 1))
ls1 ( 1 12 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
r1 ( 12 2 ) bsource r=1 / 6 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
ls2 ( 2 23 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
r2 ( 23 3 ) bsource r=1 / 3 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
ls3 ( 3 34 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
r3 ( 34 4 ) bsource r=1 / 3 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
r4 ( 4 45 ) bsource r=1 / 6 * rsh * l / (w - dw) * (1 + pvc1 * abs(v(5,1)) + pvc2 
+ * v(5,1) * v(5,1)) * tfac
ls4 ( 45 5 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * sal_fac
rend2 ( 5 lo ) resistor r=22 / (int(abs((w - 0.016u) / 0.22u) + 1))
cox1 ( 2 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.24u) * 1e+12 + cf * 2 * (w + l 
+ + 0.24u) * 1e+6)
cox2 ( 3 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.24u) * 1e+12 + cf * 2 * (w + l 
+ + 0.24u) * 1e+6)
cox3 ( 4 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.24u) * 1e+12 + cf * 2 * (w + l 
+ + 0.24u) * 1e+6)
rsub ( 6 gnode ) resistor r=rsubx * sarsub_fac
csub ( 6 gnode ) capacitor c=85f / rsubx * sacsub_fac
ends rppolys_rf
endsection rf_res_sa



section rf_res_rpo
subckt rppolywo_rf ( hi lo gnode ) 
parameters l=10u w=5u mismatchflag=0 geo_fac=1 / sqrt(l * w * 1e12) factmis=0.007 
+ * geo_fac * par_rfres_rpo * mismatchflag rsh=rppolyworf * (1 + factmis) rend0=rend_rppolyworf 
+ * (1 + factmis) dw=0.0583u + dxw_rppolyworf dl=0 + dxl_rppolyworf pt=temp pvcp1=0.0588 pvcp2=-0.000005457 pvcp3=2.6393 ptcp1=-3.44e-04 
+ ptcp2=7.32e-07 pvce1=2.1812 pvce2=-369.5605 pvce3=-2.7756 ptce1=-2.83e-03 ptce2=5.84e-06 tface=1.0 + ptce1 
+ * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * (pt - 25.0) 
+ + ptcp2 * (pt - 25.0) * (pt - 25.0) rsubtfac=1.0 + 3.74m * (pt - 25.0) + 9.1u 
+ * (pt - 25.0) * (pt - 25.0) rsubx=277 / ((1 / (0.5u + (l - dl + 0.68u) / 6) * (w 
+ - dw)) + (1 / (3u + (w - dw) / 6) * (l - dl + 0.68u))) * rsubtfac ca=ca_pofoxrf_rpo 
+ cf=cf_polfoxrf_rpo 
rend1 ( hi 1 ) bsource r=rend0 / (w) * tface * (1 + pvce1 * (tanh(pvce2 * abs(v(hi,1)) 
+ + pvce3) - tanh(pvce3)))
ls1 ( 1 12 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * rpol_fac
r1 ( 12 2 ) bsource r=1 / 6 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2 
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3)))
+ kf=kf_rppolywo_rf af=2 fexp=0.9 l=(l - dl) / 6 w=(w - dw)  wdexp=1 ldexp=1
ls2 ( 2 23 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * rpol_fac
r2 ( 23 3 ) bsource r=1 / 3 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2 
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3)))
+ kf=kf_rppolywo_rf af=2 fexp=0.9 l=(l-dl)/3 w=(w-dw)  wdexp=1 ldexp=1
ls3 ( 3 34 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * rpol_fac
r3 ( 34 4 ) bsource r=1 / 3 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2 
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3)))
+ kf=kf_rppolywo_rf af=2 fexp=0.9 l=(l-dl)/3 w=(w-dw)  wdexp=1 ldexp=1
r4 ( 4 45 ) bsource r=1 / 6 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2 
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3)))
+ kf=kf_rppolywo_rf af=2 fexp=0.9 l=(l-dl)/6 w=(w-dw)  wdexp=1 ldexp=1
ls4 ( 45 5 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) * 
+ 1e-12 * rpol_fac
rend2 ( 5 lo ) bsource r=rend0 / (w) * tface * (1 + pvce1 * (tanh(pvce2 * abs(v(5,lo)) 
+ + pvce3) - tanh(pvce3)))
cox1 ( 2 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.68u) * 1e+12 + cf * 2 * (w + l 
+ + 0.68u) * 1e+6)
cox2 ( 3 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.68u) * 1e+12 + cf * 2 * (w + l 
+ + 0.68u) * 1e+6)
cox3 ( 4 6 ) capacitor c=1 / 3 * (ca * w * (l + 0.68u) * 1e+12 + cf * 2 * (w + l 
+ + 0.68u) * 1e+6)
rsub ( 6 gnode ) resistor r=rsubx * rporsub_fac
csub ( 6 gnode ) capacitor c=85f / rsubx * rpocsub_fac
ends rppolywo_rf
endsection rf_res_rpo




