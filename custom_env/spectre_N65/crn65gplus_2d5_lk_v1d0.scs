parameters lr=1u wr=1u factor=1 mf=1 rsh=r_rnwod_m dw=0.21u pvc1=0.005037 pvc2=0.0001668 ptc1=2.93e-03 
+ ptc2=9.99e-06 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt 
+ - 25.0) 
r1 ( n2 nm ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r3 ( nn nx ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r4 ( nx n1 ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
d1 ( body n2 ) nwdio area=mf * ((wr * factor - dw) * lr * factor / 5.0) pj=mf * ((wr 
+ * factor - dw) + 2.0 * lr * factor / 5.0)
d2 ( body nm ) nwdio area=mf * ((wr * factor - dw) * lr * factor / 5.0) pj=mf * 2.0 
+ * lr * factor / 5.0
d3 ( body nn ) nwdio area=mf * ((wr * factor - dw) * lr * factor / 5.0) pj=mf * 2.0 
+ * lr * factor / 5.0
d4 ( body nx ) nwdio area=mf * ((wr * factor - dw) * lr * factor / 5.0) pj=mf * 2.0 
+ * lr * factor / 5.0
d5 ( body n1 ) nwdio area=mf * ((wr * factor - dw) * lr * factor / 5.0) pj=mf * ((wr 
+ * factor - dw) + 2.0 * lr * factor / 5.0)
