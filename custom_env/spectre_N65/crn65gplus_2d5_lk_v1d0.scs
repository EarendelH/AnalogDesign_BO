+ pvc1 * abs((v(n2,n1) / lr / factor)) + pvc2 * (v(n2,n1) / lr / factor) * (v(n2,n1) 
+ / lr / factor)) * tfac
r3 ( nn nx ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs((v(n2,n1) / lr / factor)) + pvc2 * (v(n2,n1) / lr / factor) * (v(n2,n1) 
+ / lr / factor)) * tfac
r4 ( nx n1 ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs((v(n2,n1) / lr / factor)) + pvc2 * (v(n2,n1) / lr / factor) * (v(n2,n1) 
+ / lr / factor)) * tfac
c1 ( body n2 ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c2 ( body nm ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c3 ( body nn ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c4 ( body nx ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c5 ( body n1 ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
ends rppolyl_m
 
//  *********************************     P+POLY silicide resistor (W<2um)     ***********************************
subckt rppolys_m ( n2 n1 body ) 
parameters lr=1u wr=1u factor=1 mf=1 mismatchflag=0 geo_fac=1 / sqrt(mf * lr * factor * wr * 
+ factor * 1e12) factmis=0.0113 * geo_fac * par_res_m * mismatchflag rsh=r_rppolys_m 
+ * (1 + factmis) dw= - 0.01549u + dxw_rppolys_m pvc1=4.28e-08 pvc2=7.04e-13 ptc1=0.002614034 
+ ptc2=-5.37e-06 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * 
+ (pt - 25) ca=ca_pofox cf=cf_posfox 
r1 ( n2 nm ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs((v(n2,n1) / lr / factor)) + pvc2 * (v(n2,n1) / lr / factor) * (v(n2,n1) 
+ / lr / factor)) * tfac
r2 ( nm nn ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs((v(n2,n1) / lr / factor)) + pvc2 * (v(n2,n1) / lr / factor) * (v(n2,n1) 
+ / lr / factor)) * tfac
r3 ( nn nx ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs((v(n2,n1) / lr / factor)) + pvc2 * (v(n2,n1) / lr / factor) * (v(n2,n1) 
+ / lr / factor)) * tfac
r4 ( nx n1 ) bsource r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 + 
+ pvc1 * abs((v(n2,n1) / lr / factor)) + pvc2 * (v(n2,n1) / lr / factor) * (v(n2,n1) 
+ / lr / factor)) * tfac
c1 ( body n2 ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c2 ( body nm ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c3 ( body nn ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c4 ( body nx ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c5 ( body n1 ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
ends rppolys_m
 
//  *********************************     P+POLY w/o silicide resistor     ***********************************
subckt rppolywo_m ( n2 n1 body ) 
parameters lr=1u wr=1u factor=1 mf=1 mismatchflag=0 geo_fac=1 / sqrt(mf * lr * factor * wr * 
+ factor * 1e12) factmis=0.007 * geo_fac * par_res_m * mismatchflag rsh=r_rppolywo_m 
+ * (1 + factmis) rend0=rend_rppolywo_m * (1 + factmis) dw=0.0583u + dxw_rppolywo_m 
+ dl=0 + dxl_rppolywo_m pvcp1=0.0588 pvcp2=-0.000005457 pvcp3=2.6393 ptcp1=-3.44e-04 
+ ptcp2=7.32e-07 pvce1=2.1812 pvce2=-369.5605 pvce3=-2.7756 ptce1=-2.83e-03 ptce2=5.84e-06 
+ pt=temp tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) 
+ tfacp=1.0 + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) ca=ca_pofox 
+ cf=cf_polfox 
rend1 ( n2 ns ) bsource r=rend0 / mf / wr / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(ns,n2)) + pvce3) - tanh(pvce3)))
r1 ( ns nm ) bsource r=rsh / mf * (lr * factor - dl) / (4.0 * (wr * factor - dw)) 
+ * tfacp * (1 + pvcp1 * (tanh(pvcp2 * abs(v(n2,n1) / (lr * factor - dl)) + pvcp3) 
+ - tanh(pvcp3))) kf=kf_rppolywo_dis af=2 fexp=0.9 wdexp=1 ldexp=1
r2 ( nm nn ) bsource r=rsh / mf * (lr * factor - dl) / (4.0 * (wr * factor - dw)) 
+ * tfacp * (1 + pvcp1 * (tanh(pvcp2 * abs(v(n2,n1) / (lr * factor - dl)) + pvcp3) 
+ - tanh(pvcp3))) kf=kf_rppolywo_dis af=2 fexp=0.9 wdexp=1 ldexp=1
r3 ( nn nx ) bsource r=rsh / mf * (lr * factor - dl) / (4.0 * (wr * factor - dw)) 
+ * tfacp * (1 + pvcp1 * (tanh(pvcp2 * abs(v(n2,n1) / (lr * factor - dl)) + pvcp3) 
+ - tanh(pvcp3))) kf=kf_rppolywo_dis af=2 fexp=0.9 wdexp=1 ldexp=1
r4 ( nx ne ) bsource r=rsh / mf * (lr * factor - dl) / (4.0 * (wr * factor - dw)) 
+ * tfacp * (1 + pvcp1 * (tanh(pvcp2 * abs(v(n2,n1) / (lr * factor - dl)) + pvcp3) 
+ - tanh(pvcp3))) kf=kf_rppolywo_dis af=2 fexp=0.9 wdexp=1 ldexp=1
rend2 ( ne n1 ) bsource r=rend0 / mf / wr / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,ne)) + pvce3) - tanh(pvce3)))
c1 ( body ns ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c2 ( body nm ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c3 ( body nn ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c4 ( body nx ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
c5 ( body ne ) capacitor c=mf * (ca * ((wr * factor - 0.02u) * lr * factor / 5.0) 
+ * 1e12 + 2 * cf * lr * factor / 5.0 * 1e6)
ends rppolywo_m
 
