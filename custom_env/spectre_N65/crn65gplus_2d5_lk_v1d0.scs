section rf_mos_33
 
inline subckt nmos_rf_33 ( d g s b ) 
parameters lr=0.50e-6 wr=1.0e-6 nr=4 mismatchflag=0 sigma=1 temp1=parn1rf_33 
+ temp2=parn2rf_33 fac1=0.308877 * temp1 * sigma + 0.951102 * temp2 * sigma 
+ fac2=0.308877 * temp1 * sigma - 0.951102 * temp2 * sigma lef=lr - 1.5e-08 wef=wr 
+ + 7e-09 geo_fac=1 / sqrt(nr * lef * wef * 1e12) vthmisnrf_33=0.00762502 * 
+ geo_fac * fac1 * mismatchflag dlmisnrf_33=0.00261377 * geo_fac * lef * fac2 
+ * mismatchflag dwmisnrf_33= - 0.00261377 * geo_fac * wef * fac2 * mismatchflag 
+ toxmisnrf_33=0.00261377 * geo_fac * toxnrf_33 * fac2 * mismatchflag lspace=0.31u 
+ ledge=0.73u ledgeeff=0.31u lsti=0.5u wsti=1.0u rod=835 rsti=1200 ns=int(nr / 2 
+ + 1) nd=int((nr + 1) / 2) nodd=(nr - int(nr / 2) * 2) dummyflag=1 sleff=ledge 
+ + dummyflag * (ledgeeff - ledge) sreff=ledge + dummyflag * (ledgeeff - ledge) 
+ ldios=(ns - 2) * lspace + sleff + sreff + nodd * (lspace - sleff) ldiod=(ns - 
+ 1) * lspace + nodd * sleff lod=nr * (lr + lspace) + 2 * ledge - lspace sdiofa=wr 
+ * ldios sdiofp=2 * ldios + (2 - nodd) * wr * (1 - dummyflag) ddiofa=wr * ldiod 
+ ddiofp=2 * ldiod + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) * wr 
+ * dummyflag ddiogp=wr * nr + nodd * wr * dummyflag sax=1 / (log((ledge + lr / 
+ 2 + nr * (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr + lspace)) / (ledge 
+ + lspace + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr + lspace)) + 1 / (nr 
+ * (ledge + lr / 2))) - lr / 2 rgx=((1.333 * (wr * 1e6 + 0.54) / (lr * 1e6 - 0.003) 
+ + 61.5 * lr * 1e6 + 8.53) / nr + nr * (0.00150 * wr * 1e6 + 0.02906) + 0.11307 
+ * wr * 1e6 + 0.916 * lr * 1e6 + 298.4 * lr / nr / wr) rsx=(0.0337 * (lr + lspace) 
+ * 1e6 * (2 * ns + 1 / ns - 3) + 4.056 / ns + 1.68) / (wr * 1e6) rdx=0.01 * (lr 
+ + lspace) * 1e6 * (nd + 2 / nd) + 0.2687 * (wr * 1e6 + 1.41) / nd + 0.201 / (0.2 
+ + (nd - 1) * (lr + lspace) * 1e6) rbx=(1 + 1e-8 / lr) * (rod * (lod + 4 * ledge 
+ - 2 * lspace) / 12 + rsti * lsti / 2) * (rod * wr / 12 + rsti * wsti / 2) / ((lod 
+ - 2 * ledge + lspace + 3e-6) * (rod * (lod + 4 * ledge - 2 * lspace) / 12 + rsti 
+ * lsti / 2) + wr * (rod * wr / 12 + rsti * wsti / 2)) rdbx=2.4 + 260 / (wr * nr 
+ * 1e6) + 45 / nr cgsx=(0.52 * nr * (lr + lspace) * 1e6 / (0.022 * wr * 1e6 + 1.26) 
+ + 0.27 * wr * 1e6 + 0.1) * 1e-15 cgdx=(0.15 * nr * (lr + lspace) * 1e6 + 0.05 
+ * nr + 0.1) * 1e-15 cdsx=(0.1 + 0.0455 * nr * wr / (lr + lspace) + 1.6 * nr * 
+ (lr + lspace) / (wr + 9.8e-6)) * 1e-15 tnoiax=1.273e5 / (lr * 1e6) + 8.395e6 rnoiax=0.0353 
+ / (lr * 1e6) + 0.4701 
// *********************
 
// *********************
rg ( g gi ) resistor r=rgx
rs ( s si ) resistor r=rsx
rd ( d di ) resistor r=rdx
// *********************
cgs_m ( gi si ) capacitor c=cgsx
cgd_m ( gi di ) capacitor c=cgdx
cds_m ( di si ) capacitor c=cdsx
