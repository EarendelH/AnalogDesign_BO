//              MC_RTMOM                                                      *
//        ( RTMOM capactiance corner, mismatch and statistical model)         * 
//                                                                            *                                                          
//*****************************************************************************
//
// NOTE:
//  1. All parasitics capacitances are removed from intrinsic model. The model only
//     covers the intrinsic MOSFET. All parasitic components will be handled by LPE.
//     For pre-layout simulation, contact-to-poly capacitance can be simulated by 
//     setting ccoflag=1.
//
//  2. Best approximation for gate resistance extraction is 1/3 of Rg, DC gate 
//     resistance. Current LPE tools extract gate resistors from gate edge to center 
//     of gate. Error of 1/2 Rg methodology is less than 5% when W/L < 30.  It is 
//     recommended to split wide gate transistor to meet W/L < 30 for high precision 
//     designs. For pre-layout simulation, Rg effect can be simulated by setting 
//     rgflag=1
//
//  3. The WPE (well proximity effect) is modeled in Bsim4.5. Please refer the Bsim4.5 
//     manual for model equation details. There are three new instance parameters 
//     SCA, SCB and SCC for post-layout WPE simulation. The number should be extracted
//     from LPE. For pre-layout simulation, the single instance parameter, SC (shortest 
//     distance between Well and OD shown below), is used as the only input for WPE 
//     simulation. BSIM4.5 model will calculate one set of SCA/B/C internally based 
//     on given SC to perform the simulation. 
//
//    ---------^------------------
//    |	   SC |	-----		|
//    |	    --v-|---|----	|
//    |	    | M	| O | S |	|
//    |	    ----|---|----	|
//    |		-----		|
//    |				|
//    |				|
//    |	well			|
//    -----------------------------
//
//  4. Sample netlist for BSIM4.5 WPE effect:
//     =========================
//     .temp 25.000
//     .lib 'crn65gplus_2d5_lk_v1d0p1.l' TT_25
//     Vgs g 0 -2.5
//     Vbs b 0 0.000
//     Vss0 s0 0 0.000
//     Vds0 d0 0 -0.1
//     mdut0 d0 g s0 b pch_25 w=0.400u l=1.0000u sca=2.26 scb=2.01e-4 scc=4.42e-8
//     .op
//     .dc vgs 0.3 -2.50000 -0.010000
//     .measure dc vth_dut0 find v(g) when par('abs(i(Vss0))')="1e-7*0.4/1.0000"
//     .end
//
// **********************************************************************************
//**********************     FLAG FOR FLICKER NOISE CORNERS SIMULATION  ************************
//
// NOTE:
//  1. Transistor
//     noiseflagn=0 for typical, noiseflagn=1 for worstcase, noiseflagn=-1 for best case
//     noiseflagp=0 for typical, noiseflagp=1 for worstcase, noiseflagp=-1 for best case
//  2. Resistor
//     rnoiseflag=0 for typical, rnoiseflag=1 for worstcase, rnoiseflag=-1 for best case
//
//**********************************************************************************************
//********************     MISMATCH & STATISTICAL SIMULATION FOR SPECTRE     ***********
//
// NOTE:
//  1. To have the mismatch simulation result, the stat_mis_xxx libraries have to be included
//     with an interested corner (TT/FF/SS/FS/SF) together at the same time.
//  2. Only the process variation simulation is supported in mc_xxx MOS statistical
//     model library in this release version. To have the process variation result,
//     the stat library is required to include with mc_xxx together at the same time.
//
//**********************************************************************************************

section stat_mis_rfmos 
statistics { 
 mismatch { 
  vary parn1rf dist=gauss std=1/1 
