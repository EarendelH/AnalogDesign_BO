inline subckt nch_18_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=9.25e-008 xw= + 7e-09 
+ + dxwn_18 ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / factor * 
+ (w / nf + xw / factor) pd=4 * dmcg / factor + 2 * (w / nf + xw / factor) ps=4 
+ * dmcg / factor + 2 * (w / nf + xw / factor) nrd=dmcg / factor / (w / nf + xw 
+ / factor) nrs=dmcg / factor / (w / nf + xw / factor) sa=4.6e-7 / factor sb=4.6e-7 
+ / factor sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor 
+ mismatchflag=1 temp1=parn1_18 temp2=parn2_18 fac1=0.308877 * temp1 * sigma + 0.951102 
+ * temp2 * sigma fac2=0.308877 * temp1 * sigma - 0.951102 * temp2 * sigma lef=l 
+ * factor - 1.5e-08 wef=w / nf * factor + 7e-09 geo_fac=1 / sqrt(multi * nf * lef 
+ * wef * 1e12) vthmisn_18=0.00762502 * geo_fac * fac1 * mismatchflag dlmisn_18=0.00261377 
+ * geo_fac * lef * fac2 * mismatchflag dwmisn_18= - 0.00261377 * geo_fac * wef 
+ * fac2 * mismatchflag toxmisn_18=0.00261377 * geo_fac * toxn_18 * fac2 * mismatchflag 
+ tnoiax=1.273e5 / (l * 1e6) + 8.395e6 rnoiax=0.0353 / (l * 1e6) + 0.4701 
nch_18_mac ( n1 n2 n3 n4 ) nch_18 w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
