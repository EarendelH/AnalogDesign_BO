// *********************************
//        Mismatch   model         *
// *********************************
inline subckt nch_25_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=9.25e-008 xw= + 7e-09 
+ + dxwn_25 ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / factor * 
