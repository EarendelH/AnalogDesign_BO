+ 2) * (mimflag - 3) / (1 - 2) / (1 - 3) * ( - 0.029u) + (mimflag - 1) * (mimflag 
+ - 3) / (2 - 1) / (2 - 3) * ( - 0.049u) + (mimflag - 1) * (mimflag - 2) / (3 - 
+ 1) / (3 - 2) * ( - 0.037u)) mim_b=((mimflag - 2) * (mimflag - 3) / (1 - 2) / 
+ (1 - 3) * (1.03) + (mimflag - 1) * (mimflag - 3) / (2 - 1) / (2 - 3) * (1.485) 
+ + (mimflag - 1) * (mimflag - 2) / (3 - 1) / (3 - 2) * (2.014)) mim_c=((mimflag 
+ - 2) * (mimflag - 3) / (1 - 2) / (1 - 3) * (0.207) + (mimflag - 1) * (mimflag 
+ - 3) / (2 - 1) / (2 - 3) * (0.21) + (mimflag - 1) * (mimflag - 2) / (3 - 1) / 
+ (3 - 2) * (0.218)) tcc1=((mimflag - 2) * (mimflag - 3) / (1 - 2) / (1 - 3) * 
+ ( - 5.11e-5) + (mimflag - 1) * (mimflag - 3) / (2 - 1) / (2 - 3) * ( - 5.365e-5) 
+ + (mimflag - 1) * (mimflag - 2) / (3 - 1) / (3 - 2) * ( - 1.573e-5)) tcc2=((mimflag 
+ - 2) * (mimflag - 3) / (1 - 2) / (1 - 3) * ( - 0.03e-6) + (mimflag - 1) * (mimflag 
+ - 3) / (2 - 1) / (2 - 3) * ( - 0.052e-6) + (mimflag - 1) * (mimflag - 2) / (3 
+ - 1) / (3 - 2) * ( - 0.018e-6)) vcc1=((mimflag - 2) * (mimflag - 3) / (1 - 2) 
+ / (1 - 3) * (3.66e-5) + (mimflag - 1) * (mimflag - 3) / (2 - 1) / (2 - 3) * (4.335e-5) 
+ + (mimflag - 1) * (mimflag - 2) / (3 - 1) / (3 - 2) * ( - 2.9e-5)) vcc2=((mimflag 
