model pdio_lvt diode 
+ is=1.53e-07*is_d_lvt      isw=4.96e-13*pow(2,x_jsw_d_lvt)
+ rs=1.0e-10*rs_d_lvt       n=1.005*n_d_lvt           cj=1.02e-03*cj_d_lvt
+ cjsw=6.4e-11*cjsw_d_lvt   bv=9.68                   area=3.08e-8
+ pj=7.2e-4                 mj=0.31                   mjsw=0.025
+ vj=0.7                    vjsw=0.75                 trs=2.5e-3
+ tbv1=-1*-8.0e-04          cta=8.7e-04               ctp=2.5e-04
+ pta=1.55e-03              ptp=5e-03                 ibv=0.03
+ tnom=25                   fc=0                      tlev=1
+ tlevc=1                   xti=3                     eg=1.17
+ level=1                   ns=1.005*n_d_lvt          nz=1.005*n_d_lvt
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
endsection dio_lvt
 
 
//  *************************************************************
//                                                              *
//           1.8V IO Junction DIODE MODELS                      *
//                                                              *
//  *************************************************************

section dio_18
// 
//  *************************************************************
//                       MODEL OF N+/PW DIODE                   *
//                                                              *
//  *************************************************************
 
model ndio_18 diode 
+ is=1.32e-7*is_d_18        isw=6.273e-13*pow(2,x_jsw_d_18)
+ rs=1.0e-10*rs_d_18        n=1.02*n_d_18             cj=1.161e-03*cj_d_18
+ cjsw=1.16e-10*cjsw_d_18   bv=9.2                    area=3.92e-8
+ pj=8.4e-4                 mj=0.31                   mjsw=0.105
+ vj=0.7                    vjsw=0.48                 trs=2.5e-3
+ tbv1=-1*-9.3e-04          cta=8.5e-04               ctp=3e-04
+ pta=1.55e-03              ptp=1e-03                 ibv=0.03
+ tnom=25                   fc=0                      tlev=1
+ tlevc=1                   xti=3                     eg=1.17
+ level=1                   ns=1.02*n_d_18            nz=1.02*n_d_18
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
//  *************************************************************
//                       MODEL OF P+/NW DIODE                   *
//                                                              *
//  *************************************************************
 
model pdio_18 diode 
