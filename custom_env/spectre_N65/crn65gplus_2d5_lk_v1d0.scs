+ * (1 / ((1 / (315 * w / 6 / ((l + 0.45u) * nr + 0.15u) + 554 * 3u / ((l + 0.45u) 
+ * nr + 0.15u))) + 1 / ((315 * w / 6 / ((l + 0.45u) * nr + 0.15u)) + 554 * 3u / 
+ ((l + 0.45u) * nr + 0.15u)) + 1 / (315 * ((l + 0.45u) * nr + 0.15u) / 6 / w + 
+ 554 * 3u / w) + 1 / (315 * ((l + 0.45u) * nr + 0.15u) / 6 / w + 554 * 3u / w)))) 
+ * (1 + 2.95e-3 * dt + 8.42e-6 * dt * dt)) * csub_fac
ends xjvar_nw
 
subckt xjvar ( anode cathode gnode ) 
parameters l=0.3u w=15u nr=1 nconp=int((w - 0.28u) / 0.23u + 0.1m) + 1 nconn=int((w 
+ - 0.2u) / 0.2u + 0.1m) + 1 nstrip=int(abs(l - 0.27u) / 0.23u + 0.1m) + 1 area_d1=nr 
+ * l * w peri_d1=2 * nr * (l + w) area_d2=((l + 0.45u) * nr + 2.39u) * (w + 2.24u) 
+ peri_d2=2 * (((l + 0.45u) * nr + 2.39u) + (w + 2.82u)) m1_s_sd=l + 0.45u rr_pnsd=(0.188 
+ * m1_s_sd / 1u) * (0.163 * m1_s_sd / 3u) / ((0.188 * m1_s_sd / 1u) + (0.163 * 
+ m1_s_sd / 3u)) r_1str_p=(1.5416 + ((nconp - 1) * (2 * nconp - 1) / 6 / nconp * 
+ 0.2162) + 30 / nconp) / nstrip r_1str_n=(1.504 + ((nconn - 1) * (2 * nconn - 1) 
+ / 6 / nconn * 0.188) + 30 / nconn) dt=temp - 25 
rpsd ( anode 1 ) resistor r=( - 0.4498 * (l * 1e6) + 1.0484) * (1 - (w * 1e6) / 
+ 10 * 0.02) * ((rr_pnsd / 2 + ((nr / 2 - 1) * (nr - 1) / 3 / nr * rr_pnsd) + r_1str_p 
+ / nr * 2) / 2) * (1 + 2.69e-3 * dt - 3e-7 * dt * dt) * rm_fac
l1 ( 1 2 ) inductor l=(0.0105 * w * 1e6 + 0.3755) * (w * 1e6 / 40) * (1.27e-11 * 
+ (30 / (w * 1e6)) * (0.7382 * (1 / nr) + 0.2675)) * l_fac
d1 ( 2 3 ) pdio_xj area=area_d1 pj=peri_d1
rwell ( 3 4 ) resistor r=0.64 * (20 / (w * 1e6)) * (1.8526 * (l * 1e6) * (l * 1e6) 
+ - 3.2111 * (l * 1e6) + 2.3984) * ( - 0.086 * nr + 7.9461) * ((554 * 0.15u / w 
+ + 315 * (l + 0.15u) / 2 / w) / 2 / nr) * (1 + 10.95e-3 * dt + 8.42e-6 * dt * dt) 
+ * rwell_fac
l2 ( 4 5 ) inductor l=(0.0105 * w * 1e6 + 0.3755) * (w * 1e6 / 40) * (1.27e-11 * 
+ (30 / (w * 1e6)) * (0.7382 * (1 / nr) + 0.2675)) * l_fac
rnsd ( 5 cathode ) resistor r=( - 0.4498 * (l * 1e6) + 1.0484) * (1 - (w * 1e6) 
+ / 10 * 0.02) * ((rr_pnsd / 2 + (((nr + 1) / 2 - 1) * (nr + 1 - 1) / 3 / (nr + 
+ 1) * rr_pnsd) + r_1str_n / (nr + 1) * 2) / 2) * (1 + 2.69e-3 * dt - 3e-7 * dt 
+ * dt) * rm_fac
csti ( 2 4 ) capacitor c=0.225 * w * nr * 1e-9 * (l * 1e6 + 0.02) / (l * 1e6)
d2 ( 30 3 ) dnwpsub_xj area=area_d2 pj=peri_d2
rsub ( 30 gnode ) resistor r=(1.872 / nr + 0.2225) * (30 / (w * 1e6)) * (1 / ((1 
+ / (315 * w / 6 / ((l + 0.45u) * nr + 0.15u) + 554 * 3u / ((l + 0.45u) * nr + 0.15u))) 
+ + 1 / ((315 * w / 6 / ((l + 0.45u) * nr + 0.15u)) + 554 * 3u / ((l + 0.45u) * 
+ nr + 0.15u)) + 1 / (315 * ((l + 0.45u) * nr + 0.15u) / 6 / w + 554 * 3u / w) + 
+ 1 / (315 * ((l + 0.45u) * nr + 0.15u) / 6 / w + 554 * 3u / w))) * (1 + 2.95e-3 
+ * dt + 8.42e-6 * dt * dt) * rsub_fac
csub ( 30 gnode ) capacitor c=(1.65e-13 / ((1.872 / nr + 0.2225) * (30 / (w * 1e6)) 
+ * (1 / ((1 / (315 * w / 6 / ((l + 0.45u) * nr + 0.15u) + 554 * 3u / ((l + 0.45u) 
+ * nr + 0.15u))) + 1 / ((315 * w / 6 / ((l + 0.45u) * nr + 0.15u)) + 554 * 3u / 
+ ((l + 0.45u) * nr + 0.15u)) + 1 / (315 * ((l + 0.45u) * nr + 0.15u) / 6 / w + 
+ 554 * 3u / w) + 1 / (315 * ((l + 0.45u) * nr + 0.15u) / 6 / w + 554 * 3u / w)))) 
+ * (1 + 2.95e-3 * dt + 8.42e-6 * dt * dt)) * csub_fac
ends xjvar
 
