//  *********************************     N+OD w/o silicide resistor     ***********************************
subckt rnodwo ( n1 n2 ) 
parameters l=1u w=1u factor=1 pt=temp mf=1 mismatchflag=0 geo_fac=1 / sqrt(mf * l * factor 
+ * w * factor * 1e12) factmis=0.002461 * geo_fac * par_res * mismatchflag rsh=r_rnodwo 
+ * (1 + factmis) rend0=rend_rnodwo * (1 + factmis) dw=0.003u + dxw_rnodwo dl=0 
+ + dxl_rnodwo pvcp1=0.1115 pvcp2=1.17e-05 pvcp3=1.583 ptcp1=1.58e-03 ptcp2=4.18e-07 
+ pvce1=1.134 pvce2=-230.8184 pvce3=-1.3458 ptce1=2.51e-03 ptce2=-1.38e-06 tface=1.0 
+ + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * 
+ (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) bsource r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rp ( 3 4 ) bsource r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp * (1 
+ + pvcp1 * (tanh(pvcp2 * abs(v(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) bsource r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rnodwo
 
//  *********************************     P+OD w/o silicide resistor     ***********************************
subckt rpodwo ( n1 n2 ) 
parameters l=1u w=1u factor=1 pt=temp mf=1 mismatchflag=0 geo_fac=1 / sqrt(mf * l * factor 
+ * w * factor * 1e12) factmis=0.0041 * geo_fac * par_res * mismatchflag rsh=r_rpodwo 
+ * (1 + factmis) rend0=rend_rpodwo * (1 + factmis) dw=0.0001u + dxw_rpodwo dl=0 
+ + dxl_rpodwo pvcp1=-0.0137 pvcp2=-5.50e-06 pvcp3=0.9113 ptcp1=1.33e-03 ptcp2=5.71e-07 
+ pvce1=0.0768 pvce2=-1.34e+03 pvce3=-0.4978 ptce1=3.54e-04 ptce2=1.59e-06 tface=1.0 
+ + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * 
+ (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) bsource r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rp ( 3 4 ) bsource r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp * (1 
+ + pvcp1 * (tanh(pvcp2 * abs(v(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) bsource r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rpodwo
 
//  *********************************     N+POLY w/o silicide resistor     ***********************************
subckt rnpolywo ( n1 n2 ) 
parameters l=1u w=1u factor=1 pt=temp mf=1 mismatchflag=0 geo_fac=1 / sqrt(mf * l * factor 
+ * w * factor * 1e12) factmis=0.033 * geo_fac * par_res * mismatchflag rsh=r_rnpolywo 
+ * (1 + factmis) rend0=rend_rnpolywo * (1 + factmis) dw=0.0691u + dxw_rnpolywo 
+ dl=0 + dxl_rnpolywo pvcp1=-5.8869 pvcp2=-0.000066371 pvcp3=-3.9236 ptcp1=1.75e-04 
+ ptcp2=2.52e-07 pvce1=1.7575 pvce2=-4383.7 pvce3=-1.4398 ptce1=2.52e-03 ptce2=9.92e-06 
+ tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 
+ + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) bsource r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rp ( 3 4 ) bsource r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp * (1 
+ + pvcp1 * (tanh(pvcp2 * abs(v(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3))) l=l-dl w=mf*(w-dw) kf=kf_rnpolywo af=2 fexp=0.86 wdexp=1 ldexp=1
rend2 ( 4 n2 ) bsource r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rnpolywo
 
//  *********************************     P+POLY w/o silicide resistor     ***********************************
