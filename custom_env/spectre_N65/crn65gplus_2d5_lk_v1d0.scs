// **** Diodes  ****************
dss ( si sb ) pdio_rf_25_f area=sdiofa pj=sdiofp
ddd ( di db ) pdio_rf_25_f area=ddiofa pj=ddiofp
dsg ( si sb ) pdio_rf_25_g area=1e-15 pj=sdiogp
