inline subckt pch_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=7e-008 xw= + 1.6e-08 
+ + dxwp ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / factor * (w 
+ / nf + xw / factor) pd=4 * dmcg / factor + 2 * (w / nf + xw / factor) ps=4 * dmcg 
+ / factor + 2 * (w / nf + xw / factor) nrd=dmcg / factor / (w / nf + xw / factor) 
+ nrs=dmcg / factor / (w / nf + xw / factor) sa=0.405e-6 / factor sb=0.405e-6 / 
+ factor sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor 
+ mismatchflag=1 temp1=parp1 temp2=parp2 fac1=0.836583 * temp1 * sigma + 0.547841 
+ * temp2 * sigma fac2=0.836583 * temp1 * sigma - 0.547841 * temp2 * sigma lef=l 
+ * factor - 1.09e-08 wef=w / nf * factor + 1.6e-08 geo_fac=1 / sqrt(multi * nf 
+ * lef * wef * 1e12) vthmisp=0.00215161 * geo_fac * fac1 * mismatchflag dlmisp=0.00170787 
+ * geo_fac * lef * fac2 * mismatchflag dwmisp= - 0.00170787 * geo_fac * wef * fac2 
+ * mismatchflag toxmisp=0.00170787 * geo_fac * toxp * fac2 * mismatchflag tnoiax=3.163e05 
+ / (l * 1e6) + 5.918e07 rnoiax=0.02751 / (l * 1e6) + 0.3577 
pch_mac ( n1 n2 n3 n4 ) pch w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
