//  *******************************************************************************************************************
//                                                                              
//            N65 RF RTMOM                                                      
//                                                                              
//            parameter range: nv : 6~288, nh : 6~288                           
//                             nv and nh should be even fingers                 
//                             w(width):0.1u ~0.16u                             
//                             s(spacing):0.1u ~0.16u                           
//                             stm(start metal layer):M1,M2,M3,M4,M5 (M2,M3,M4,M5 are inter metals (Mx thk=0.22um))   *
//                             spm(stop metal layer):M3,M4,M5,M6,M7 (M3,M4,M5,M6,M7are inter metals (Mx thk=0.22um)) *
//                             Total metal is at least 3 layers stacked with ploy shield                              *
//                             mismatchflag=0 for no mismatch                   
//                             mismatchflag=1 for mismatch                      
//  *******************************************************************************************************************
subckt crtmom_rf ( a b p ) 
parameters nv=32 nh=32 w=0.14u s=0.14u stm=1 spm=7 mismatchflag=0 layno=spm - stm 
+ + 1 laym1=int(layno / spm) layodd=int((layno + (stm - 2) * (stm - 3) * (stm - 
+ 4) * (stm - 5) / (24) + (stm - 1) * (stm - 2) * (stm - 4) * (stm - 5) / (4) + 
+ (stm - 1) * (stm - 2) * (stm - 3) * (stm - 4) / 24) / 2) - laym1 layeven=int((layno 
+ + (stm - 1) * (stm - 3) * (stm - 4) * (stm - 5) / ( - 6) + (stm - 1) * (stm - 
+ 2) * (stm - 3) * (stm - 5) / ( - 6)) / 2) edg=((layodd + 1800 / 2200 * laym1) 
+ * (nv - 1) * (nh * (w + s) - s) + layeven * (nh - 1) * (nv * (w + s) - s)) area=nv 
+ * nh / 2 * w * (layno - 1) fri1=(2 * nh * nv * w) * (layno - 1) fri2=((layodd 
+ + 1800 / 2200 * laym1) * nv * w + layeven * nh * w) + layeven * (nv * (w + s) 
+ - s + 0.2u) * 2 + layno * 0.11u * 2 + (layodd + 1800 / 2200 * laym1) * (nh * (w 
+ + s) - s) * 2 abm=((nv * (w + s) - s + (0.11u + 0.2u) * 2) + (nh * (w + s) - s 
+ + 0.2u)) * 0.11u afm=(nv * w * (nh * (w + s) - s + 0.2u)) / 2 pf=(nh * (w + s) 
+ - s + 0.2u) * (nv) * 2 / 2 + 2 * ((nv * (w + s) - s + (0.2u + 0.11u) * 2) + (nh 
+ * (w + s) - s + 0.2u + 0.11u)) pfb=((nh * (w + s) - s) + 0.2u + 0.11u) * 3.6 cc1=1.14 
+ * ( - 0.244660016615909 * (s * 1e6) - 0.0710279441604613 * (w * 1e6) - 0.488519079260245 
+ * (s * 1e6) * (w * 1e6) + 0.110902118000523) cc2=1.14 * 0.0434096210759646 cf=(0.0123567105762849 
+ * (s * 1e6) - 0.00266215734172082 * (w * 1e6) + 0.215236738982277 * (s * 1e6) 
+ * (w * 1e6) + 0.00623893734392313) ca=(0.164257743030535 * (s * 1e6) + 0.210106799625508 
+ * (w * 1e6) - 0.838732645422224 * (s * 1e6) * (w * 1e6) - 0.0143235048162527) 
+ ca_p_a=((stm - 2) * (stm - 3) * (stm - 4) * (stm - 5) / (1 - 2) / (1 - 3) / (1 
+ - 4) / (1 - 5) * (0.184399492837775) + (stm - 1) * (stm - 3) * (stm - 4) * (stm 
+ - 5) / (2 - 1) / (2 - 3) / (2 - 4) / (2 - 5) * (0.0562169811320459) + (stm - 1) 
+ * (stm - 2) * (stm - 4) * (stm - 5) / (3 - 1) / (3 - 2) / (3 - 4) / (3 - 5) * 
+ (0.0303182627269607) + (stm - 1) * (stm - 2) * (stm - 3) * (stm - 5) / (4 - 1) 
