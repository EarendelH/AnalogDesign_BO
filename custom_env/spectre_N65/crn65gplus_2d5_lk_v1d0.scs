section tt_rfind
parameters c12_indfac=1.0
parameters rm9_indfac=1.0
parameters l_indfac=1.0
parameters cm9_indfac=1.0
parameters csub_indfac=1.0
parameters rsub_indfac=1.0
include "crn65gplus_2d5_lk_v1d0.scs" section=rf_ind
endsection tt_rfind


 
section ff_rfind
parameters c12_indfac=0.926
parameters rm9_indfac=0.9
parameters l_indfac=0.9762
parameters cm9_indfac=0.913
parameters csub_indfac=1.25
parameters rsub_indfac=0.8
include "crn65gplus_2d5_lk_v1d0.scs" section=rf_ind
endsection ff_rfind


 
section ss_rfind
parameters c12_indfac=1.081
parameters rm9_indfac=1.1
parameters l_indfac=1.0235
parameters cm9_indfac=1.07
parameters csub_indfac=0.8333
parameters rsub_indfac=1.2
