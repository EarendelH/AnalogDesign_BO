//  *************************************************************
//                                                              *
//           Standard-vt Junction DIODE MODELS                  *
//                                                              *
//  *************************************************************

section dio
// 
//  *************************************************************
//                       MODEL OF N+/PW DIODE                   *
//                                                              *
//  *************************************************************
model ndio diode 
+ level=1                   is=1.35e-07*is_d          rs=1.0e-10*rs_d
+ n=1.02*n_d                bv=9.03                   ibv=0.03
+ isw=2.5e-13*pow(2,x_jsw_d)                          cj=0.00127*cj_d
+ pj=7.2e-4                 mj=0.32                   fc=0
+ cjsw=6.4e-11*cjsw_d       area=3.08e-8              mjsw=0.05
+ tlevc=1                   cta=8.0e-04               ctp=4.00e-04
+ trs=2.5e-3                tbv1=-1*-0.80e-03         tlev=1
+ xti=3                     eg=1.17                   vjsw=1.12
+ vj=0.7                    pta=1.6e-3                tnom=25
+ ptp=1e-03                 ns=1.02*n_d               nz=1.02*n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
//  *************************************************************
//                       MODEL OF P+/NW DIODE                   *
//                                                              *
//  *************************************************************
model pdio diode 
+ level=1                   is=1.73e-07*is_d          rs=1.0e-10*rs_d
+ n=1.02*n_d                bv=9.59                   ibv=0.03
+ isw=1.86e-13*pow(2,x_jsw_d)                         cj=1.06e-03*cj_d
+ pj=7.2e-4                 mj=0.31                   fc=0
+ cjsw=6.4e-11*cjsw_d       area=3.08e-8              mjsw=0.063
+ tlevc=1                   cta=8.5e-04               ctp=2.0e-04
+ trs=2.5e-3                tbv1=-1*-7.9e-04          tlev=1
+ xti=3                     eg=1.17                   vjsw=0.96
+ vj=0.7                    pta=1.55e-3               tnom=25
+ ptp=1.5e-03               ns=1.02*n_d               nz=1.02*n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
model nwdio diode 
+ is=2.49e-6*is_d           isw=8.22e-13*pow(2,x_jsw_d)
+ rs=1.0e-10*rs_d           n=1.005*n_d               cj=1.388e-04*cj_d
+ cjsw=7.49e-10*cjsw_d      bv=11.8                   area=3.1161e-8
+ pj=7.24e-4                mj=0.325                  mjsw=0.31
+ vj=0.5                    vjsw=0.5                  trs=2.5e-3
+ tbv1=-1*-9.000e-04        cta=2.16e-3               ctp=1.3e-03
+ pta=2.60e-3               ptp=1.6e-03               ibv=0.03
+ tnom=25                   fc=0                      tlev=1
+ tlevc=1                   xti=3                     eg=1.17
+ level=1                   ns=1.005*n_d              nz=1.005*n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
endsection dio
 
//  *************************************************************
//                                                              *
//           High-vt Junction DIODE MODELS                      *
//                                                              *
//  *************************************************************

section dio_hvt
// 
//  *************************************************************
//                       MODEL OF N+/PW DIODE                   *
//                                                              *
//  *************************************************************
 
model ndio_hvt diode 
+ is=1.203e-07*is_d_hvt     isw=1.666e-13*pow(2,x_jsw_d_hvt)
+ rs=1.0e-10*rs_d_hvt       n=1.005*n_d_hvt           cj=1.3297e-03*cj_d_hvt
+ cjsw=6.69e-11*cjsw_d_hvt  bv=8.92                   area=3.08e-8
+ pj=7.2e-4                 mj=0.34                   mjsw=0.06
+ vj=0.7                    vjsw=0.9                  trs=2.5e-3
+ tbv1=-1*-8.77e-04         cta=8.00e-04              ctp=3.0e-04
+ pta=1.55e-03              ptp=1.0e-03               ibv=0.03
+ tnom=25                   fc=0                      tlev=1
+ tlevc=1                   xti=3                     eg=1.17
+ level=1                   ns=1.005*n_d_hvt          nz=1.005*n_d_hvt
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
// 
//  *************************************************************
//                       MODEL OF P+/NW DIODE                   *
//                                                              *
//  *************************************************************
 
model pdio_hvt diode 
+ is=1.45e-07*is_d_hvt      isw=1.57e-13*pow(2,x_jsw_d_hvt)
+ rs=1.0e-10*rs_d_hvt       n=1.005*n_d_hvt           cj=1.080e-03*cj_d_hvt
+ cjsw=6.4e-11*cjsw_d_hvt   bv=9.52                   area=3.08e-8
+ pj=7.2e-4                 mj=0.315                  mjsw=0.039
+ vj=0.7                    vjsw=0.49                 trs=2.5e-3
+ tbv1=-1*-9.3e-04          cta=9.50e-04              ctp=2.80e-04
+ pta=1.68e-03              ptp=2.10e-03              ibv=0.03
+ tnom=25                   fc=0                      tlev=1
+ tlevc=1                   xti=3                     eg=1.17
+ level=1                   ns=1.005*n_d_hvt          nz=1.005*n_d_hvt
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
endsection dio_hvt
 
