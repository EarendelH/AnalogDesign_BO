+ level=1                   is=1.73e-07               rs=1.0e-10
+ n=1.02                    bv=9.59                   ibv=0.03
+ isw=1.86e-13              cj=1.06e-03*cj_fac        pj=7.2e-4
+ mj=0.31                   fc=0                      cjsw=6.4e-11*cjsw_fac
+ area=3.08e-8              mjsw=0.063                tlevc=1
+ cta=8.5e-04               ctp=2.0e-04               trs=2.5e-3
+ tbv1=-1*-7.9e-04          tlev=1                    xti=3
+ eg=1.17                   vjsw=0.96                 vj=0.7
+ pta=1.55e-3               tnom=25                   ptp=1.5e-03
+ ns=1.02                   nz=1.02                   imax=1e40
+ minr=1e-10                allow_scaling=1
 
endsection dio_pdio_xj
 
 

section dio_dnwpsub_xj
