inline subckt pch_33_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=9.25e-08 xw= + 7e-09 
+ + dxwp_33 ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / factor * 
+ (w / nf + xw / factor) pd=4 * dmcg / factor + 2 * (w / nf + xw / factor) ps=4 
+ * dmcg / factor + 2 * (w / nf + xw / factor) nrd=dmcg / factor / (w / nf + xw 
+ / factor) nrs=dmcg / factor / (w / nf + xw / factor) sa=4.6e-07 / factor sb=4.6e-07 
+ / factor sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor 
+ mismatchflag=1 temp1=parp1_33 temp2=parp2_33 fac1=0.955472 * temp1 * sigma + 0.295081 
+ * temp2 * sigma fac2=0.955472 * temp1 * sigma - 0.295081 * temp2 * sigma lef=l 
+ * factor - 1.5e-08 wef=w / nf * factor + 7e-09 geo_fac=1 / sqrt(multi * nf * lef 
+ * wef * 1e12) vthmisp_33=0.00615610 * geo_fac * fac1 * mismatchflag dlmisp_33=0.00242520 
+ * geo_fac * lef * fac2 * mismatchflag dwmisp_33= - 0.00242520 * geo_fac * wef 
+ * fac2 * mismatchflag toxmisp_33=0.00242520 * geo_fac * toxp_33 * fac2 * mismatchflag 
+ tnoiax=1.91e6 / (l * 1e6) + 2.818e7 rnoiax=0.0064 / (l * 1e6) + 0.4993 
pch_33_mac ( n1 n2 n3 n4 ) pch_33 w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
