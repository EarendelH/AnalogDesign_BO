//  ************************************************************************
//                                                                         *
//               2.5V IO NMOS in N-Well varactor MODEL                     *
//                                                                         *
//  ************************************************************************

section mos_cap_25
// 
subckt nmoscap_25 ( ng nds ) 
parameters factor=1.0 lr=1e-6 wr=1e-6 xl=1.5e-08 xw=-7.0e-09 area=(lr * factor - xl + dxl_var25) 
+ * (wr * factor - xw + dxw_var25) cgmin=1.420e-10 * cgmin_var25 * 2 * (wr * factor 
+ - xw + dxw_var25) + 3.964e-10 * cgmin_var25 * 2 * (lr * factor - xl + dxl_var25) 
+ + 8.80e-04 * cgmin_var25 * area dcg= - 9e-11 * dcg_var25 * 2 * (wr * factor - xw 
+ + dxw_var25) + 2e-12 * dcg_var25 * 2 * (lr * factor - xl + dxl_var25) + 2.4e-03 
+ * dcg_var25 * area dvgs= - 0.22 - 1.1e-03 * (temp - 25) vgnorm=0.7 + 1.0e-03 
+ * (temp - 25) 
 
cg ( ng nds ) bsource q=(cgmin+dcg)*v(ng,nds)+vgnorm*dcg*ln(cosh((v(ng,nds)-dvgs)/vgnorm))
 
ends nmoscap_25
 
endsection mos_cap_25
 
 
 
