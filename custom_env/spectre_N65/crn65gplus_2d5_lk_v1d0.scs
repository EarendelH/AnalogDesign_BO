+ vjsw=0.45                 trs=2.5e-3                tbv1=-1*-8.500e-04
+ cta=2.20e-3               ctp=1.29e-03              pta=2.95e-3
+ ptp=1.7e-03               ibv=0.03                  tnom=25
+ fc=0                      tlev=1                    tlevc=1
+ xti=3                     eg=1.17                   level=1
+ ns=1.005                  nz=1.005                  imax=1e40
+ minr=1e-10                allow_scaling=1
endsection dio_dnwpsub_xj
 
 

section dio_nwpsub_xj
