+ + br * ld2d + (br + 1) * 1.3e-7) / 2.3e-7 / (br + 1) * 2) rrd=rrrd + rdvia_array 
+ rdm1=0.188 * (1.3e-7 + ld2d) / 1e-06 rdm2=0.163 * (1.3e-7 + ld2d) / 2.8e-06 rdmhead=1 
+ / (1 / rdm1 + 1 / rdm2) rd=(rdmhead / 2 + ((br + 1) / 2 - 1) * br / (6 * ((br 
+ + 1) / 2)) * rdmhead + rrd / ((br + 1) / 2)) / 2 lm1g=1.4e-6 + wr * factor * gr 
+ + 0.23e-6 * (gr - 1) wm1g=lr * factor - 0.09e-6 * int((lr * factor - 0.2e-6) / 
+ 0.2e-6) rgm=0.16 * lm1g / (3 * wm1g * br) rgp=17.0 * wr * factor / (12 * lr * 
+ factor * gr * br) rgch=((lr * factor * 1e6) ** ( - 0.038119)) / (12 * 0.002072) 
+ / ((wr * factor * 1e6) ** 0.656366) / (gr ** 0.818013) / (br ** 1.066443) rg=rgm 
+ + rgp + rgch lm1s=(1.2 - 0.015) * 1e-6 + wr * factor * gr + 0.23e-6 * (gr - 1) 
