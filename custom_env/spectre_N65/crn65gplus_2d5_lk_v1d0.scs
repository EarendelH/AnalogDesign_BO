inline subckt nch_na33_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=1.135e-007 xw= + 
+ 7e-09 + dxwn_na33 ad=2 * dmcg / factor * (w / nf + xw / factor) as=2 * dmcg / 
+ factor * (w / nf + xw / factor) pd=4 * dmcg / factor + 2 * (w / nf + xw / factor) 
+ ps=4 * dmcg / factor + 2 * (w / nf + xw / factor) nrd=dmcg / factor / (w / nf 
+ + xw / factor) nrs=dmcg / factor / (w / nf + xw / factor) sa=4.6e-7 / factor sb=4.6e-7 
+ / factor sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor 
+ mismatchflag=1 temp1=parn1_na33 temp2=parn2_na33 fac1=0.010100 * temp1 * sigma 
+ + 0.999949 * temp2 * sigma fac2=0.010100 * temp1 * sigma - 0.999949 * temp2 * 
+ sigma lef=l * factor - 3.859e-8 wef=w / nf * factor + 7e-09 geo_fac=1 / sqrt(multi 
+ * nf * lef * wef * 1e12) vthmisn_na33=0.00190412 * geo_fac * fac1 * mismatchflag 
+ dlmisn_na33=0.00191205 * geo_fac * lef * fac2 * mismatchflag dwmisn_na33= - 0.00191205 
+ * geo_fac * wef * fac2 * mismatchflag toxmisn_na33=0.00191205 * geo_fac * toxn_na33 
+ * fac2 * mismatchflag tnoiax=1.903e04 / (l * 1e6) + 8.634e6 rnoiax= - 0.1171 / 
+ (l * 1e6) + 0.6655 
nch_na33_mac ( n1 n2 n3 n4 ) nch_na33 w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
