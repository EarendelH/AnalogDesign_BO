// *************************************************************************************************
// 
//  1.0V CORE SVT MOS MODEL
// 
// 
// 
//               .lib RF_MOS
// 
//               Model name       nr               lr (um)           wr (um)
//                             low   high        low     high     low    high
//             -----------------------------------------------------------------
//               nmos_rf        1     32         0.06    0.24     0.6    6.0
//             -----------------------------------------------------------------
//               pmos_rf        1     32         0.06    0.24     0.6    6.0
//             -----------------------------------------------------------------
//               pmos_rf_nw     1     32         0.06    0.24     0.6    6.0
//             -----------------------------------------------------------------
//             **nr: Finger number
//             **wr: Width per finger
// 
// *************************************************************************************************

section rf_mos
inline subckt nmos_rf ( d g s b ) 
parameters lr=0.06e-6 wr=1e-6 nr=4 mismatchflag=0 sigma=1 temp1=parn1rf temp2=parn2rf 
+ fac1=0.443742 * temp1 * sigma + 0.896155 * temp2 * sigma fac2=0.443742 * temp1 
+ * sigma - 0.896155 * temp2 * sigma lef=lr - 1.46e-08 wef=wr + 1.6e-08 geo_fac=1 
+ / sqrt(nr * lef * wef * 1e12) vthmisnrf=0.00235886 * geo_fac * fac1 * mismatchflag 
+ dlmisnrf=0.00171632 * geo_fac * lef * fac2 * mismatchflag dwmisnrf= - 0.00171632 
+ * geo_fac * wef * fac2 * mismatchflag toxmisnrf=0.00171632 * geo_fac * toxnrf 
+ * fac2 * mismatchflag lspace=0.24u ledge=0.45u ledgeeff=0.24u lsti=0.5u wsti=1.0u 
