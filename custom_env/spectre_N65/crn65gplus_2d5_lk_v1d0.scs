+ - 1) / (3 - 2) * ( - 2.97e-5)) cmimbb_corner=((mimflag - 2) * (mimflag - 3) / 
+ (1 - 2) / (1 - 3) * (cmimbb_mimfac) + (mimflag - 1) * (mimflag - 3) / (2 - 1) 
