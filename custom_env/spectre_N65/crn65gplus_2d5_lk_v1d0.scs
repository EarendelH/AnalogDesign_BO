+ ne=1.1853                 br=0.11643                nr=1.0084
+ var=50.466                ikr=0.0086                isc=7.1479e-019*isb
+ nc=0.95086                rb=294.32*rbb             irb=0.001
+ rbm=0.1*rbmb              re=3.0158*reb             rc=13.31*rcb
