+ mismatchflag=1 temp1=parp1_25 temp2=parp2_25 fac1=0.955472 * temp1 * sigma + 0.295081 
+ * temp2 * sigma fac2=0.955472 * temp1 * sigma - 0.295081 * temp2 * sigma lef=l 
+ * factor - 1.5e-08 wef=w / nf * factor + 7e-09 geo_fac=1 / sqrt(multi * nf * lef 
+ * wef * 1e12) vthmisp_25=0.00615610 * geo_fac * fac1 * mismatchflag dlmisp_25=0.00242520 
+ * geo_fac * lef * fac2 * mismatchflag dwmisp_25= - 0.00242520 * geo_fac * wef 
+ * fac2 * mismatchflag toxmisp_25=0.00242520 * geo_fac * toxp_25 * fac2 * mismatchflag 
+ tnoiax=1.91e6 / (l * 1e6) + 2.818e7 rnoiax=0.0064 / (l * 1e6) + 0.4993 
