model ndio_lvt diode 
+ is=1.368e-7*is_d_lvt      isw=1.828e-13*pow(2,x_jsw_d_lvt)
+ rs=1.0e-10*rs_d_lvt       n=1.007*n_d_lvt           cj=1.207e-03*cj_d_lvt
+ cjsw=6.4e-11*cjsw_d_lvt   bv=9.05                   area=3.08e-8
+ pj=7.2e-4                 mj=0.31                   mjsw=0.08
+ vj=0.73                   vjsw=1                    trs=2.5e-3
+ tbv1=-1*-8.00e-04         cta=0.00075               ctp=0.0009
+ pta=1.6e-03               ptp=1.0e-04               ibv=0.03
+ tnom=25                   fc=0                      tlev=1
+ tlevc=1                   xti=3                     eg=1.17
+ level=1                   ns=1.007*n_d_lvt          nz=1.007*n_d_lvt
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
// 
//  *************************************************************
